# Copy to .env and adjust. Docker Compose reads this file automatically.

# --- Federated identity ------------------------------------------------------
# Scheme + host + PORT together form the actor URI namespace.
#
# READ THIS BEFORE CHANGING IT IN ANYTHING BUT DEVELOPMENT:
# actor URIs are permanent. Remote servers store them. Changing the host does
# not migrate anything — it breaks every existing follow while remote instances
# keep POSTing to an endpoint that no longer answers. Pick the production
# hostname once, and use a separate dev./staging. subdomain for testing.
FEDERATION_BASE_URL=http://allure.test:3001

# Must match the scheme in FEDERATION_BASE_URL. Use https in production. Plain
# HTTP is reserved for the local federation ring when ALLOW_PRIVATE_IPS=true.
FEDERATION_PROTOCOL=http

# The separately gated restricted audience. Off by default everywhere: the
# built-in followers profile stays unavailable, and followers-only delivery and
# fetch fail closed. Enable it only to publish to explicitly promoted peers.
FEDERATION_RESTRICTED_ENABLED=false

# Escape hatch for the local multi-node test ring (PLAN.md §6, Tier 2), where
# instances address each other by Docker network alias over plain HTTP.
# Disables the SSRF guard's private-range checks. MUST be false in production;
# the app refuses to boot otherwise.
ALLOW_PRIVATE_IPS=true

# --- Instance operator -------------------------------------------------------
# The one account allowed to open /admin (the administration console, including
# federation diagnostics and block/promotion controls). When unset, no account
# is an operator and the console is unreachable. Development defaults to the
# seeded `marie` account; production has no default and must set this
# explicitly.
# INSTANCE_OPERATOR_USERNAME=marie

# --- Sessions -----------------------------------------------------------------
# A signed-in session closes after this many days without activity, and at the
# latest this many days after signing in (docs/dev/AUTH.md). Defaults: 30 / 90.
# AUTH_SESSION_IDLE_DAYS=30
# AUTH_SESSION_MAX_DAYS=90
# Days a password account may sign in before it must set up two-step
# verification (0 = at the next sign-in). The operator never has a grace period.
# AUTH_2FA_GRACE_DAYS=14
# Comma-separated TEAMID.bundle identifiers allowed to use this instance's
# passkeys from the iOS companion (served at /.well-known/apple-app-site-association).
# IOS_APP_IDS=

# --- Demo mode (PLAN_DEMO.md) ---------------------------------------------------
# A throwaway public instance recreated from the development seed every night.
# Off by default; everything the mode changes is listed in PLAN_DEMO.md.
# For trying it in development: DEMO_INSTANCE=1 bin/rails demo:reset.
# The development operator is `marie` by default, so a demo reset also needs
# DEMO_OPERATOR_PASSWORD (at least 15 characters, different from DEMO_PASSWORD).
# DEMO_INSTANCE=false
# Never include INSTANCE_OPERATOR_USERNAME among the shared accounts.
# DEMO_ACCOUNTS=tom
# DEMO_PASSWORD=allure-dev-password
# DEMO_OPERATOR_PASSWORD=
# DEMO_RESET_AT=03:00

# --- Identity providers (docs/dev/AUTH.md) --------------------------------------
# Each provider is enabled only when all its keys are set; restart after a
# change. Callback URLs to register: FEDERATION_BASE_URL + /auth/google/callback,
# /auth/apple/form_post (Apple, HTTPS only), /auth/oidc/callback.
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_APPLE_SERVICES_ID=
# AUTH_APPLE_TEAM_ID=
# AUTH_APPLE_KEY_ID=
# The .p8 key on one line, newlines written as \n.
# AUTH_APPLE_PRIVATE_KEY=
# A generic OpenID Connect provider. Development: `dip compose --profile oidc
# up -d dex`, then these three values (user rider@dex.test / password).
# AUTH_OIDC_ISSUER=http://dex.test:5556/dex
# AUTH_OIDC_CLIENT_ID=allure-dev
# AUTH_OIDC_CLIENT_SECRET=allure-dev-secret
# AUTH_OIDC_LABEL=Dex
# Refuse a sign-in whose ID token states another authentication context, or
# whose `amr` lacks a method (e.g. `mfa` for a provider whose acr never varies).
# AUTH_OIDC_REQUIRED_ACR=
# AUTH_OIDC_REQUIRED_AMR=

# --- Instance presentation ---------------------------------------------------
# Public display metadata: footer, NodeInfo, and the PWA description. None of
# it feeds actor URIs or signed objects, and every value stays hidden when
# unset (INSTANCE_NAME defaults to "Allure"). The configured name is also
# refused as a username at sign-up, in its username-space form.
# INSTANCE_NAME=Allure
# INSTANCE_DESCRIPTION=A self-hosted Allure instance.
# INSTANCE_HOST_NAME=Camille
# INSTANCE_HOST_URL=https://example.org

# --- Metrics (Prometheus / Grafana) ------------------------------------------
# Bearer token for GET /metrics, the Prometheus text exposition consumed by an
# external Prometheus or Grafana Alloy. When unset the endpoint answers 404 and
# no aggregates are computed. Generate with: openssl rand -hex 32
# METRICS_TOKEN=

# Push notifications for the iOS companion (docs/dev/PUSH.md). Off until the three
# VAPID values are set: no settings card, no job. Generate a key pair with
# `dip rails push:vapid_keys`; VAPID_SUBJECT is a mailto: or https: contact the
# relay operator can reach. PUSH_RELAY_ORIGINS lists the relays this instance
# may send to (comma-separated origins, default https://push.allure.rocks); the
# instance never posts anywhere else.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# PUSH_RELAY_ORIGINS=https://push.allure.rocks

# Ceiling on the location an API token may hand an AI assistant through /mcp
# (docs/dev/MCP.md): none, filtered or raw. Unset means no ceiling.
# MCP_GEOMETRY_MAX=

# Rails Active Record Encryption keys. Required before local actor provisioning
# is enabled in production. Generate and manage these outside the repository;
# never commit them or place private federation keys in job arguments.
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Local ports -------------------------------------------------------------
# Published for host-side GUI clients. Not 5432, which commonly collides.
POSTGRES_PORT=5443

# --- Federation ring (PLAN.md §6, Tier 2) ------------------------------------
# Two full Allure instances on the Compose network, dormant behind the
# `federation` profile. See docker-compose.fed.yml.
#
# Add this to the host /etc/hosts once, so the browser reaches each node on the
# same hostname and port its actor URIs advertise:
#
#   127.0.0.1 allure-a.test allure-b.test
#
# Host ports for the two ring databases. The application ports are fixed at
# 3002 and 3003 because they are part of the permanent actor identity.
# FED_A_POSTGRES_PORT=5444
# FED_B_POSTGRES_PORT=5445

# --- Registration --------------------------------------------------------------
# Open sign-ups. Set to false on single-user instances: the sign-in page then
# states plainly that registration is closed instead of linking a dead form.
ALLOW_REGISTRATION=true

# --- Vite --------------------------------------------------------------------
# Extra hostnames the dev server will accept (comma separated). Required for the
# federation ring: both nodes proxy to this one dev server, so it must accept
# their aliases as well.
VITE_ALLOWED_HOSTS=allure-a.test,allure-b.test

# --- Basemap -----------------------------------------------------------------
# MapLibre style documents, one per theme. The light style also renders the
# owner-only static route PNG. The style names its own tile, glyph and sprite
# endpoints and carries the attribution its provider requires.
#
# The default is the OpenFreeMap public instance: no API key, no registration,
# no request limits. It is a third party, so it learns the approximate bounds of
# whatever route is on screen. Point these at a self-hosted tile server for a
# privacy-strict deployment; no application code changes.
#
# Setting MAP_STYLE_URL without MAP_STYLE_URL_DARK reuses the light style in
# both themes rather than mixing in a second provider.
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark

# Extra DNS hosts used by sources, sprites, or glyphs referenced from a custom
# style. The style URL's own host is allowed automatically; every other browser
# request is blocked. The default OpenFreeMap style needs no extra host.
# ROUTE_IMAGE_MAP_ORIGINS=https://tiles.internal.example,https://fonts.internal.example
# ROUTE_IMAGE_RENDER_TIMEOUT_MS=30000

# --- Geocoding ---------------------------------------------------------------
# Optional in production. When configured, Allure sends route coordinates sampled
# every 100 metres to this Nominatim-compatible server after import, at a maximum
# rate of 10 requests/second, to build the owner's route timeline. Short routes
# may use finer lookups and a bounded settlement-center search.
# Leave unset for a privacy-strict deployment with no geocoding. This is an
# explicit opt-in in every environment because sampled coordinates leave Allure.
# GEOCODING_BASE_URL=https://geocoding.allure.rocks

# --- Terrain elevation -------------------------------------------------------
# Optional. When configured, an account that opted in can fill a workout with
# no recorded altitude from an OpenTopoData-compatible server, and choose the
# terrain profile instead of the device profile per workout. Coordinates are
# sampled every ELEVATION_SAMPLE_METRES and sent in batches of at most 100.
# Leave unset for a privacy-strict deployment: nothing is sent and no altitude
# is estimated. Self-hosting OpenTopoData on the Compose network is recommended
# (e.g. ELEVATION_BASE_URL=http://opentopodata:5000); the client is not the
# federation transport, so private addresses are allowed.
# ELEVATION_BASE_URL=https://opentopodata.allure.rocks
# ELEVATION_DATASET=mapzen
# ELEVATION_INTERPOLATION=bilinear
# ELEVATION_SAMPLE_METRES=50
# ELEVATION_REQUESTS_PER_SECOND=5
# ELEVATION_MAX_REQUESTS_PER_WORKOUT=40

# --- Weather -----------------------------------------------------------------
# Optional (docs/dev/WEATHER.md). When enabled, an account that explicitly opted in
# gets the historical weather along its outdoor workouts from Open-Meteo:
# positions rounded to 0.1° (~11 km), their recorded elevation and the
# workout's hours are sent, one request per workout in the ordinary case.
# Workouts since WEATHER_FORECAST_SINCE ask the historical-forecast API, older
# ones the ERA5 archive. Open-Meteo's free API is for non-commercial use only
# (about 10 000 calls a day); a commercial plan uses its customer-* hosts in
# the two URLs and WEATHER_API_KEY. A self-hosted Open-Meteo works too.
# Leave unset for a privacy-strict deployment: nothing is sent.
# WEATHER_ENABLED=true
# WEATHER_FORECAST_URL=https://historical-forecast-api.open-meteo.com
# WEATHER_ARCHIVE_URL=https://archive-api.open-meteo.com
# WEATHER_FORECAST_SINCE=2022-01-01
# WEATHER_API_KEY=
# WEATHER_REQUESTS_PER_SECOND=2
# WEATHER_MAX_REQUESTS_PER_DAY=5000

# Workout photos (docs/dev/PHOTOS.md): owner originals plus stripped derivatives.
# Quota is per account; the operator can override it, including zero.
# PHOTOS_ENABLED=true
# PHOTOS_QUOTA_MB=2048

# Final fallback after five failed MapLibre attempts. Raster tiles are stitched
# behind the owner route before falling back once more to the tile-less drawing.
# MAP_RASTER_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Remote import sources (PLAN_REMOTE_IMPORTS.md) ---------------------------
# Off by default. Garmin Connect has no public API: Allure reproduces the Garmin
# Connect mobile application's sign-in, which Garmin may change or refuse from a
# server address at any time; enable it knowingly. Linking and the hourly sync
# run on the `remote_imports` queue of the ordinary worker.
# GARMIN_CONNECT_IMPORT_ENABLED=true
# EXR (virtual rowing) has no API either: Allure signs in to the EXR account
# site once and keeps only its five-year "remember me" cookie, never the
# password.
# EXR_IMPORT_ENABLED=true
# Withings (connected watches) has no public API for routes either: Allure
# drives the Health Mate application's private API, keeps only a day-long
# session and never the password, and synthesizes a TCX original from the
# location, elevation and heart-rate series.
# WITHINGS_IMPORT_ENABLED=true
# Zwift (virtual cycling and running) has no public API for individuals: Allure
# reads the mobile application's API, keeps only the refresh token (eight days,
# rotated on every refresh) and never the password, and downloads the original
# FIT from Zwift's S3 bucket. Zwift exposes only the newest 250 activities.
# ZWIFT_IMPORT_ENABLED=true

# --- GitLab feedback ----------------------------------------------------------
# When enabled, signed-in users can capture and annotate a screenshot before
# creating an issue in this GitLab project. The project can be a numeric ID or
# a URL-encoded namespace path such as group/allure.
GITLAB_ENABLED=false
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PROJECT_ID=
GITLAB_TOKEN=
GITLAB_LABELS=feedback,allure
GITLAB_CONFIDENTIAL=false
# Optional voluntary funding (off by default). HTTPS hosted checkout links;
# payments are confirmed manually from the operator's account administration.
# Stripe subscriptions (optional): one annual subscription payment link and
# price per tier, plus the API key and webhook secret.
FUNDING_ENABLED=
FUNDING_LINK_COFFEE=
FUNDING_LINK_BEER=
FUNDING_LINK_ENERGY=
FUNDING_STRIPE_SECRET_KEY=
FUNDING_STRIPE_WEBHOOK_SECRET=
FUNDING_STRIPE_PRICE_COFFEE=
FUNDING_STRIPE_PRICE_BEER=
FUNDING_STRIPE_PRICE_ENERGY=
FUNDING_STRIPE_LINK_COFFEE=
FUNDING_STRIPE_LINK_BEER=
FUNDING_STRIPE_LINK_ENERGY=
