# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Temporary files generated by your text editor or operating system
.DS_Store
*.swp
*~
/.idea
/.vscode

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets built by Vite.
/public/vite*
/node_modules

# Ignore master key for decrypting credentials and more.
/config/master.key

# Local environment overrides.
/.env
/.env.*
!/.env.example
/demo.env

# Test artefacts
/coverage

# Local, untracked read-only design references and conformance corpora.
/references_apps

# Local agent notes: a private overlay for this checkout, never published.
/AGENTS.local.md

# Local-only Markdown overlays: never published.
*.local.md

# Vite Ruby
/public/vite*
node_modules
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vitejs.dev/guide/env-and-mode.html#env-files
*.local


# Operator documentation build output (docs/site, VitePress).
/docs/site/.vitepress/dist
/docs/site/.vitepress/cache

# Icon fonts are copied out of node_modules by bin/sync-icon-fonts on npm install.
/public/fonts/tabler
