# The demo instance's environment (PLAN_DEMO.md, RUNBOOK_DEMO.md). Copy to
# demo.env (chmod 600), keep the copy outside version control, and pass it as
# --env-file to Compose; bin/demo-nightly-reset reads the same file.
#
# Everything below is recreated every night: never point this instance at data
# you care about, and never sign in with a password you use anywhere else.

APP_HOST=demo.example.com
FEDERATION_BASE_URL=https://demo.example.com

# The images (RUNBOOK_DEMO.md §1): the production image to extend, the local
# demo tag this host builds, and the published route-image worker.
# ALLURE_IMAGE=registry.example.com/allure:<release-tag>
# ALLURE_DEMO_IMAGE=allure-demo:<release-tag>
# ALLURE_ROUTE_IMAGE_IMAGE=registry.example.com/allure:route-image-latest

SECRET_KEY_BASE=replace-with-a-long-random-value
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace-me
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace-me
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace-me
ALLURE_DATABASE_PASSWORD=replace-with-a-long-random-password

# The demo's mail is throwaway; the domain must accept the address nowhere.
MAILER_DOMAIN=demo.example.com
MAILER_FROM="Allure démo <noreply@demo.example.com>"
SMTP_HOSTNAME=demo-mail.example.com

RAILS_LOG_LEVEL=info

# The demo accounts: the credentials the sign-in page publishes. Only the
# member account is shared; visitors sign in as tom alone. Including
# INSTANCE_OPERATOR_USERNAME in DEMO_ACCOUNTS is a boot error.
DEMO_ACCOUNTS=tom

# The shared password displayed on the sign-in page and assigned to the
# account above by the seed. It is public by design; never reuse it.
DEMO_PASSWORD=change-me

# The operator (never published on the sign-in page). The demo always runs
# the administration console: the seed assigns this password on every pass,
# so it survives the nightly reset. It is mandatory — the app refuses to boot
# while it is empty — must be at least 15 characters and must differ from
# DEMO_PASSWORD. Generate one and paste the output here:
#
#     openssl rand -hex 24
#
INSTANCE_OPERATOR_USERNAME=marie
DEMO_OPERATOR_PASSWORD=

# Historical weather for the seeded accounts that opted in (tom, marie, joan,
# inès): Open-Meteo's archive, no key needed.
WEATHER_ENABLED=true

# The nightly reset, one single source: the app's warning strip and
# bin/demo-nightly-reset both read these two values. Run the wrapper from cron
# every minute (see RUNBOOK_DEMO.md).
DEMO_RESET_AT=03:00
TZ=Europe/Paris

# The demo's toponymy: a Nominatim-compatible service the operator controls.
GEOCODING_BASE_URL=https://geocoding.example.com

# Maps (optional): point at your own tile service or leave unset for the
# default basemap.
# MAP_STYLE_URL=
# MAP_STYLE_URL_DARK=
# MAP_RASTER_TEMPLATE=
# ROUTE_IMAGE_MAP_ORIGINS=
