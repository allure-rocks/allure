<% content_for :title, t("segments.efforts.title") %>

<% content_for :page_header do %>
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle"><%= t("segments.efforts.pretitle") %></div>
      <h1 class="page-title"><%= @segment.name %></h1>
    </div>
    <% if @segment.viewable_by?(current_user) %>
      <div class="col-auto"><%= link_to t("segments.efforts.back"), segment_path(@segment), class: "btn btn-outline-secondary" %></div>
    <% end %>
  </div>
<% end %>

<div class="card">
  <div class="card-header"><h3 class="card-title"><%= t("segments.efforts.title") %></h3></div>
  <%= render "segments/efforts", efforts: @efforts, segment: @segment %>
</div>
