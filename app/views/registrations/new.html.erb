<% content_for :title, t("registrations.new.title") %>

<div class="card card-md">
  <div class="card-body">
    <h1 class="h2 text-center mb-4"><%= t("registrations.new.title") %></h1>

    <%= form_with model: @user, url: registration_path, data: credential_form_data do |form| %>
      <%= render "shared/form_errors", form: form %>

      <%= hidden_field_tag :invitation_token, @invitation_token if @invitation_token %>

      <div class="mb-3" data-controller="availability"
           data-availability-url-value="<%= availability_registration_path(invitation_token: @invitation_token) %>"
           data-availability-available-value="<%= t("registrations.new.username_available") %>"
           data-availability-taken-value="<%= t("registrations.new.username_taken") %>">
        <%= form.label :username, t("registrations.new.username"), class: "form-label" %>
        <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username",
              class: class_names("form-control", "is-invalid": @user.errors[:username].any?),
              data: { availability_target: "input", action: "input->availability#check" } %>
        <% if @user.errors[:username].any? %>
          <div class="invalid-feedback"><%= @user.errors.full_messages_for(:username).to_sentence %></div>
        <% end %>
        <small class="form-text"><%= t("registrations.new.username_hint") %></small>
        <div class="small mt-1" data-availability-target="status" role="status"></div>
      </div>
      <div class="mb-3">
        <%= form.label :email_address, t("registrations.new.email"), class: "form-label" %>
        <%= form.email_field :email_address, required: true, autocomplete: "email",
              readonly: @invitation.present?,
              class: class_names("form-control", "is-invalid": @user.errors[:email_address].any?) %>
        <% if @user.errors[:email_address].any? %>
          <div class="invalid-feedback"><%= @user.errors.full_messages_for(:email_address).to_sentence %></div>
        <% end %>
        <% if @invitation.present? %>
          <small class="form-text"><%= t("registrations.new.invitation_email_hint") %></small>
        <% end %>
      </div>
      <div class="mb-3">
        <%= form.label :display_name, t("registrations.new.display_name"), class: "form-label" %>
        <%= form.text_field :display_name, maxlength: 60, autocomplete: "name", size: nil,
              class: class_names("form-control", "is-invalid": @user.errors[:display_name].any?) %>
        <% if @user.errors[:display_name].any? %>
          <div class="invalid-feedback"><%= @user.errors.full_messages_for(:display_name).to_sentence %></div>
        <% end %>
        <small class="form-text"><%= t("registrations.new.display_name_hint") %></small>
      </div>
      <div class="mb-3"
           data-controller="password-visibility"
           data-password-visibility-show-label-value="<%= t("forms.password.show") %>"
           data-password-visibility-hide-label-value="<%= t("forms.password.hide") %>">
        <%= form.label :password, t("registrations.new.password"), class: "form-label" %>
        <div class="input-group">
          <%= form.password_field :password, required: true, autocomplete: "new-password",
                minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72, size: nil,
                class: class_names("form-control", "is-invalid": @user.errors[:password].any?),
                data: { password_visibility_target: "input" } %>
          <button class="btn btn-outline-secondary" type="button"
                  data-action="password-visibility#toggle"
                  data-password-visibility-target="button"
                  aria-pressed="false"
                  aria-label="<%= t("forms.password.show") %>"
                  data-controller="tooltip"
                  data-bs-title="<%= t("forms.password.show") %>">
            <i class="ti ti-eye" data-password-visibility-target="icon" aria-hidden="true"></i>
          </button>
        </div>
        <% if @user.errors[:password].any? %>
          <div class="invalid-feedback d-block"><%= @user.errors.full_messages_for(:password).to_sentence %></div>
        <% end %>
        <small class="form-text"><%= t("forms.password.minimum_hint", count: User::MINIMUM_PASSWORD_LENGTH) %></small>
      </div>
      <div class="mb-3"
           data-controller="password-visibility"
           data-password-visibility-show-label-value="<%= t("forms.password.show") %>"
           data-password-visibility-hide-label-value="<%= t("forms.password.hide") %>">
        <%= form.label :password_confirmation, t("registrations.new.password_confirmation"), class: "form-label" %>
        <div class="input-group">
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
                maxlength: 72, size: nil, class: "form-control",
                data: { password_visibility_target: "input" } %>
          <button class="btn btn-outline-secondary" type="button"
                  data-action="password-visibility#toggle"
                  data-password-visibility-target="button"
                  aria-pressed="false"
                  aria-label="<%= t("forms.password.show") %>"
                  data-controller="tooltip"
                  data-bs-title="<%= t("forms.password.show") %>">
            <i class="ti ti-eye" data-password-visibility-target="icon" aria-hidden="true"></i>
          </button>
        </div>
      </div>
      <div class="form-footer">
        <%= form.submit t("registrations.new.submit"), class: "btn btn-primary w-100" %>
      </div>
    <% end %>
    <%= render "sessions/providers", intent: "sign_in", invitation_token: @invitation_token %>
  </div>
</div>

<div class="text-center text-secondary mt-3">
  <%= link_to t("registrations.new.sign_in"), new_session_path %>
</div>
