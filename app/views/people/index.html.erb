<% content_for :title, t("people.title") %>

<% content_for :page_header do %>
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle"><%= t("people.pretitle") %></div>
      <h1 class="page-title"><%= t("people.title") %></h1>
    </div>
  </div>
<% end %>

<div class="row row-deck row-cards">
  <div class="col-12">
    <%= render "people/search" %>
  </div>

  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <%# Navigation links between the hub's views, not an ARIA tab widget:
            the current one carries `aria-current="page"` (DESIGN.md §10.15). %>
        <ul class="nav nav-tabs card-header-tabs" aria-label="<%= t("people.tabs.label") %>">
          <% PeopleController::TABS.each do |tab| %>
            <% count = { "following" => @following_count, "followers" => @followers_count, "requests" => @requests_count }.fetch(tab) %>
            <li class="nav-item">
              <%= link_to people_path(tab:),
                    class: class_names("nav-link", active: @tab == tab),
                    aria: { current: (@tab == tab ? "page" : nil) } do %>
                <%= t("people.tabs.#{tab}") %>
                <span class="badge bg-secondary-lt ms-1"><%= count %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>

      <% if @tab == "requests" %>
        <div class="list-group list-group-flush">
          <div class="list-group-header"><%= t("people.incoming.title") %></div>
          <% if @incoming_requests.any? %>
            <% @incoming_requests.each do |following| %>
              <div class="list-group-item d-flex align-items-center gap-2">
                <%= actor_avatar_tag(following.follower_actor, size: "sm") %>
                <div class="flex-fill min-w-0">
                  <%= link_to actor_name(following.follower_actor), actor_profile_path(following.follower_actor),
                        class: "fw-bold text-reset" %>
                  <div class="text-secondary small text-truncate"><%= actor_handle(following.follower_actor) %></div>
                </div>
                <div class="allure-actions">
                  <%= button_to t("people.decisions.accept.submit"), people_follow_path(following, decision: "accept"),
                                method: :patch, class: "btn btn-sm btn-primary" %>
                  <%= button_to t("people.decisions.reject.submit"), people_follow_path(following, decision: "reject"),
                                method: :patch, class: "btn btn-sm btn-ghost-danger" %>
                </div>
              </div>
            <% end %>
            <% if @pagy.last > 1 %>
              <div class="list-group-item d-flex justify-content-center"><%== pagy_bootstrap_nav(@pagy) %></div>
            <% end %>
          <% else %>
            <div class="list-group-item text-secondary"><%= t("people.incoming.empty") %></div>
          <% end %>

          <div class="list-group-header"><%= t("people.outgoing.title") %></div>
          <% if @outgoing_requests.any? %>
            <% @outgoing_requests.each do |following| %>
              <div class="list-group-item d-flex align-items-center gap-2">
                <%= actor_avatar_tag(following.followed_actor, size: "sm") %>
                <div class="flex-fill min-w-0">
                  <%= link_to actor_name(following.followed_actor), actor_profile_path(following.followed_actor),
                        class: "fw-bold text-reset" %>
                  <div class="text-secondary small text-truncate"><%= actor_handle(following.followed_actor) %></div>
                </div>
                <div class="allure-actions">
                  <%= render "follows/button", target: (following.followed_actor.acct.presence || following.followed_actor.handle),
                             following: following %>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="list-group-item text-secondary"><%= t("people.outgoing.empty") %></div>
          <% end %>
        </div>
      <% elsif @people.any? %>
        <% removable = @tab == "followers" %>
        <div class="list-group list-group-flush">
          <% @people.each do |following| %>
            <% actor = removable ? following.follower_actor : following.followed_actor %>
            <%= render "people/person", actor:, following:, removable: %>
          <% end %>
        </div>
        <% if @pagy.last > 1 %>
          <div class="card-footer d-flex justify-content-center"><%== pagy_bootstrap_nav(@pagy) %></div>
        <% end %>
      <% else %>
        <div class="card-body">
          <p class="text-secondary mb-0"><%= t("people.#{@tab}.empty") %></p>
        </div>
      <% end %>
    </div>
  </div>

  <% if @tab == "following" && @suggestions.any? %>
    <div class="col-12">
      <%= render "people/suggestions", suggestions: @suggestions %>
    </div>
  <% end %>
</div>
