<%# The live search fragment (PLAN_PEOPLE.md §3). It carries only what a
    result may show: avatar, name, handle, the viewer's relationship, and the
    follow control. No biography, place, sport, statistic or activity. %>
<% if results.empty? %>
  <div class="dropdown-item-text text-secondary small py-2"><%= t("people.search.no_results") %></div>
<% else %>
  <% results.each do |result| %>
    <div class="dropdown-item d-flex align-items-center gap-2 py-2">
      <%= result.local? ? avatar_tag(result.user, size: "sm") : actor_avatar_tag(result.actor, size: "sm") %>
      <div class="flex-fill min-w-0">
        <div class="fw-bold text-truncate">
          <%= link_to result.name,
                result.local? ? profile_path(result.user.username) : actor_profile_path(result.actor),
                class: "text-reset", data: { turbo_frame: "_top" } %>
        </div>
        <div class="text-secondary small text-truncate">
          <%= result.handle %>
          <% if result.following? %>
            <span class="badge bg-secondary-lt ms-1"><%= t("people.relationships.following") %></span>
          <% elsif result.requested? %>
            <span class="badge bg-secondary-lt ms-1"><%= t("people.relationships.requested") %></span>
          <% elsif result.follower? %>
            <span class="badge bg-secondary-lt ms-1"><%= t("people.relationships.follower") %></span>
          <% elsif result.incoming_request? %>
            <span class="badge bg-secondary-lt ms-1"><%= t("people.relationships.incoming_request") %></span>
          <% end %>
        </div>
      </div>
      <div class="allure-actions">
        <%= render "follows/button", target: result.target, following: result.outgoing %>
      </div>
    </div>
  <% end %>
<% end %>
