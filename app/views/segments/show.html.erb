<% content_for :title, @segment.name %>
<% publication_actions = @owner_view && @segment.kind == "segment" %>
<% participation_action = current_user && @segment.shareable? %>

<% content_for :page_header do %>
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle"><i class="ti ti-route me-1"></i><%= @owner_view ? t("segments.show.pretitle") : t("segments.show.shared_pretitle") %></div>
      <h1 class="page-title"><%= @segment.name %></h1>
      <div class="text-secondary small d-flex flex-wrap align-items-center gap-2">
        <% if @segment.sport %><%= sport_tile_tag(@segment.sport, size: :sm) %><% end %>
        <%= @segment.sport ? sport_display_name(@segment.sport) : t("segments.details.all_sports") %>
        <% if publication_actions %>
          <% if @publication %>
            <%= publication_badge(@publication.audience, label: t("segments.publication.published_as", audience: t("segments.publication.audience.#{@publication.audience}"))) %>
            <% if @publication_stale %><span class="badge bg-yellow-lt"><%= t("segments.publication.stale") %></span><% end %>
          <% elsif @segment.shareable? %>
            <%= publication_badge("unpublished", label: t("segments.publication.unpublished")) %>
          <% end %>
        <% end %>
      </div>
      <% unless @owner_view %>
        <div class="text-secondary small">
          <%= t("segments.created_by") %>
          <%= link_to @segment.user.display_name, profile_path(@segment.user.username), class: "text-reset fw-medium" %>
          <span>@<%= @segment.user.username %></span>
        </div>
      <% end %>
    </div>
    <% if @owner_view %>
      <div class="col-auto ms-auto d-print-none">
        <div class="btn-list">
          <%= link_to t("segments.show.edit"), edit_segment_path(@segment), class: "btn btn-sm btn-outline-primary" %>
          <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= t("segments.show.actions.menu") %>">
              <i class="ti ti-dots" aria-hidden="true"></i>
            </button>
            <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
              <% if participation_action %>
                <% if @opted_out %>
                  <%= button_to t("segments.listing.rejoin"), segment_opt_out_path(@segment), method: :delete, class: "dropdown-item" %>
                <% else %>
                  <%= button_to t("segments.listing.exclude"), segment_opt_out_path(@segment), class: "dropdown-item" %>
                <% end %>
                <div class="dropdown-divider"></div>
              <% end %>
              <% if @segment.source_workout %>
                <%= link_to t("segments.source.view"), workout_path(@segment.source_workout), class: "dropdown-item" %>
              <% else %>
                <span class="dropdown-item-text text-secondary small"><%= t("segments.source.deleted") %></span>
              <% end %>
              <% if %w[segment route].include?(@segment.kind) %>
                <%= button_to t("segments.copy.reverse_own.#{@segment.kind}"), segment_copy_path(@segment), params: { direction: "reverse" }, class: "dropdown-item" %>
              <% end %>
              <% if publication_actions %>
                <div class="dropdown-divider"></div>
                <span class="dropdown-item-text text-secondary small allure-menu-text"><%= t("segments.publication.preview") %></span>
                <% if @publication %>
                  <% if @publication_stale %>
                    <span class="dropdown-item-text text-secondary small allure-menu-text"><%= t("segments.publication.stale_hint") %></span>
                    <%= button_to t("segments.publication.republish"), republish_segment_path(@segment), class: "dropdown-item" %>
                  <% end %>
                  <%= button_to t("segments.publication.delete"), publication_segment_path(@segment), method: :delete, form: { data: { confirm_title: t("segments.publication.confirm.title"), confirm_body: t("segments.publication.confirm.body"), confirm_verb: t("segments.publication.confirm.verb") } }, class: "dropdown-item text-danger" %>
                <% elsif !@segment.shareable? %>
                  <span class="dropdown-item-text text-secondary small allure-menu-text"><%= t("segments.publication.private_hint") %></span>
                <% elsif @corridor_intersects && @segment.privacy_zone_acknowledged_at.blank? %>
                  <span class="dropdown-item-text text-warning small allure-menu-text"><%= t("segments.form.corridor.body") %></span>
                <% else %>
                  <%= button_to t("segments.publication.publish"), publish_segment_path(@segment), class: "dropdown-item" %>
                <% end %>
              <% end %>
              <div class="dropdown-divider"></div>
              <%= button_to t("segments.show.delete"), segment_path(@segment), method: :delete, form: { data: { confirm_title: t("segments.show.confirm.title"), confirm_body: t("segments.show.confirm.body"), confirm_verb: t("segments.show.confirm.verb") } }, class: "dropdown-item text-danger" %>
            </div>
          </div>
        </div>
      </div>
    <% elsif participation_action %>
      <div class="col-auto ms-auto d-print-none">
        <div class="btn-list">
          <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= t("segments.show.actions.menu") %>">
              <i class="ti ti-dots" aria-hidden="true"></i>
            </button>
            <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
              <% if @opted_out %>
                <%= button_to t("segments.listing.rejoin"), segment_opt_out_path(@segment), method: :delete, class: "dropdown-item" %>
              <% else %>
                <%= button_to t("segments.listing.exclude"), segment_opt_out_path(@segment), class: "dropdown-item" %>
              <% end %>
              <div class="dropdown-divider"></div>
              <%= button_to t("segments.copy.action"), segment_copy_path(@segment), params: { direction: "forward" }, class: "dropdown-item" %>
              <%= button_to t("segments.copy.reverse"), segment_copy_path(@segment), params: { direction: "reverse" }, class: "dropdown-item" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<% if @segment.description.present? %>
  <div class="card mb-3"><div class="card-body"><%= simple_format(h(@segment.description)) %></div></div>
<% end %>

<div class="allure-detail-layout allure-detail-layout--split">
  <div class="allure-detail-before-map">
    <section class="allure-detail-section">
      <% tiles = segment_detail_tiles(@segment, efforts: @efforts, owner_view: @owner_view,
                                      standing: @standing, signed_in: current_user.present?,
                                      participants_count: @participants_count) %>
      <div class="card mb-3">
        <div class="card-header"><h3 class="card-title"><%= t("segments.details.title") %></h3></div>
        <div class="card-body">
          <dl class="allure-primary-metrics mb-0">
            <% tiles[:primary].each do |tile| %>
              <%= render "workouts/metric_tile", metric: tile, stamp: tile[:stamp] %>
            <% end %>
          </dl>
          <% if tiles[:secondary].any? %>
            <dl class="allure-secondary-metrics mb-0 mt-4 pt-4 border-top">
              <% tiles[:secondary].each do |tile| %>
                <div>
                  <dt><%= tile[:label] %></dt>
                  <dd><%= workout_metric_value(tile) %></dd>
                </div>
              <% end %>
            </dl>
          <% end %>
        </div>
      </div>
    </section>
  </div>

  <div class="allure-detail-map">
    <section class="allure-detail-section allure-detail-map-panel">
      <%= render "map", segment: @segment %>
    </section>
  </div>

  <div class="allure-detail-after-map">
    <section class="allure-detail-section">
      <% if @segment.elevation_profile.present? %>
        <%= render "elevation_chart" %>
      <% else %>
        <div class="card mb-3">
          <div class="card-header"><h2 class="card-title"><%= t("segments.show.chart.title") %></h2></div>
          <div class="card-body text-secondary">
            <i class="ti ti-chart-area-line me-1" aria-hidden="true"></i><%= t("segments.show.chart.unavailable") %>
          </div>
        </div>
      <% end %>
    </section>
  </div>
</div>

<div class="allure-detail-fullwidth">
  <% if @segment.shareable? %>
    <div class="card mb-3" id="classements">
      <div class="card-header">
        <h3 class="card-title"><%= t("segments.leaderboard.container_title") %></h3>
        <div class="card-actions d-flex flex-wrap align-items-center gap-2">
          <%= segment_board_scope_nav(@board_scope) { |board| segment_path(@segment, board:, anchor: "classements") } %>
          <% if @board_sections.any? { |_sport, efforts| efforts.size > 10 } %>
            <%= link_to t("segments.leaderboard.view_all"), segment_leaderboard_path(@segment, board: (@board_scope == "everyone" ? nil : @board_scope)), class: "btn btn-sm btn-outline-secondary" %>
          <% end %>
          <% if participation_action %>
            <% if @opted_out %>
              <%= button_to t("segments.listing.rejoin"), segment_opt_out_path(@segment), method: :delete, class: "btn btn-sm btn-primary" %>
            <% else %>
              <%= button_to t("segments.listing.exclude"), segment_opt_out_path(@segment), class: "btn btn-sm btn-outline-danger" %>
            <% end %>
          <% end %>
        </div>
      </div>

      <% unless @owner_view %>
        <div class="card-body pb-0">
          <div class="alert alert-info mb-0"><%= t("segments.leaderboard.residual_risk") %></div>
        </div>
      <% end %>

      <% if @board_sections.empty? %>
        <div class="card-body">
          <div class="empty">
            <div class="empty-icon"><i class="ti ti-users fs-1 text-primary" aria-hidden="true"></i></div>
            <p class="empty-title"><%= @board_scope == "following" ? t("segments.leaderboard.following_empty_title") : t("segments.leaderboard.empty_title") %></p>
            <p class="empty-subtitle text-secondary"><%= t("segments.leaderboard.empty_subtitle") %></p>
          </div>
        </div>
      <% else %>
        <% @board_sections.each do |sport, efforts| %>
          <% if @board_sections.many? %>
            <div class="card-body pb-0 pt-3">
              <h4 class="card-title"><%= t("segments.leaderboard.sport_title", name: @segment.name, sport: sport_display_name(sport)) %></h4>
            </div>
          <% end %>
          <%= render "segments/shared_efforts", efforts: efforts.first(10), segment: @segment, owner_view: @owner_view, sport: sport %>
        <% end %>
      <% end %>

      <% if participation_action %>
        <%# The viewer's own line (DESIGN.md §20.6): who sees them on this board,
            or the one reason nobody does, then the rule in one sentence. %>
        <div class="card-body border-top">
          <% if @reach %>
            <p class="mb-1"><%= segment_reach_badge(@reach) %></p>
            <p class="small mb-2"><%= t("segments.listing.reach_hint.#{@reach}") %></p>
          <% end %>
          <p class="text-secondary small mb-0"><%= t("segments.listing.notice") %> <%= help_link("segments") %></p>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if current_user %>
    <div class="card mb-3">
      <div class="card-header">
        <h3 class="card-title"><%= t("segments.efforts.title") %></h3>
        <% if @efforts.any? %>
          <div class="card-actions"><%= link_to t("segments.efforts.view_all"), segment_efforts_path(@segment), class: "btn btn-sm btn-outline-secondary" %></div>
        <% end %>
      </div>
      <% if @effort_history.chartable? %>
        <%= render "progress_chart", history: @effort_history, segment: @segment %>
      <% end %>
      <%= render "efforts", efforts: @efforts.first(10), segment: @segment %>
    </div>
  <% end %>
</div>
