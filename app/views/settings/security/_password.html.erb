<%# The password card: a change for a password account, a first password for
    a provider account (docs/dev/AUTH.md). Alone on its row it keeps a
    readable form width. Locals: user, narrow. %>
<div class="card">
  <div class="card-header">
    <h3 class="card-title"><%= t(user.password? ? "settings.security.password.title" : "settings.security.password.add_title") %></h3>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="<%= narrow ? "col-lg-8 col-xl-6" : "col-12" %>">
        <%= form_with model: user, url: settings_security_password_path, method: :patch do |form| %>
          <%= render "shared/form_errors", form: form %>

          <% unless user.password? %>
            <p class="text-secondary"><%= t("settings.security.password.add_copy") %></p>
          <% end %>
          <div class="mb-3" <%= "hidden" unless user.password? %>>
            <%= form.label :current_password, t("settings.security.password.current"), class: "form-label" %>
            <%= form.password_field :current_password, required: user.password?, autocomplete: "current-password",
                  maxlength: 72, size: nil, class: class_names("form-control", "is-invalid": user.errors[:current_password].any?) %>
            <% if user.errors[:current_password].any? %>
              <div class="invalid-feedback"><%= user.errors.full_messages_for(:current_password).to_sentence %></div>
            <% end %>
          </div>
          <div class="mb-3">
            <%= form.label :password, t("settings.security.password.new"), class: "form-label" %>
            <%= form.password_field :password, required: true, autocomplete: "new-password",
                  minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72, size: nil,
                  class: class_names("form-control", "is-invalid": user.errors[:password].any?) %>
            <% if user.errors[:password].any? %>
              <div class="invalid-feedback d-block"><%= user.errors.full_messages_for(:password).to_sentence %></div>
            <% end %>
            <small class="form-text"><%= t("forms.password.minimum_hint", count: User::MINIMUM_PASSWORD_LENGTH) %></small>
          </div>
          <div class="mb-3">
            <%= form.label :password_confirmation, t("settings.security.password.confirmation"), class: "form-label" %>
            <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
                  minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72, size: nil, class: "form-control" %>
          </div>
          <div class="form-footer">
            <%= form.submit t(user.password? ? "settings.security.password.submit" : "settings.security.password.add_submit"), class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
