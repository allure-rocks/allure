<%# The webhook's ⋯ menu (DESIGN.md §20.18). %>
<div class="dropdown">
  <button class="btn btn-outline-secondary btn-icon btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false"
          aria-label="<%= t("settings.webhooks.menu", name: endpoint.host) %>">
    <i class="ti ti-dots" aria-hidden="true"></i>
  </button>
  <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
    <%= link_to t("settings.webhooks.actions.show"), settings_webhook_path(endpoint), class: "dropdown-item" %>
    <%= link_to t("settings.webhooks.actions.edit"), edit_settings_webhook_path(endpoint), class: "dropdown-item" %>
    <% if endpoint.deliverable? %>
      <%= button_to t("settings.webhooks.actions.ping"), ping_settings_webhook_path(endpoint), class: "dropdown-item" %>
    <% end %>
    <%= button_to t("settings.webhooks.actions.rotate_secret"), rotate_secret_settings_webhook_path(endpoint), class: "dropdown-item",
                  form: { data: { confirm_title: t("settings.webhooks.confirm_rotate.title"),
                                  confirm_body: t("settings.webhooks.confirm_rotate.body"),
                                  confirm_verb: t("settings.webhooks.confirm_rotate.verb") } } %>
    <%= button_to (endpoint.deliverable? ? t("settings.webhooks.actions.pause") : t("settings.webhooks.actions.enable")),
                  toggle_settings_webhook_path(endpoint), method: :patch, class: "dropdown-item" %>
    <div class="dropdown-divider"></div>
    <%= button_to settings_webhook_path(endpoint), method: :delete, class: "dropdown-item text-danger",
                  form: { data: { confirm_title: t("settings.webhooks.confirm_delete.title"),
                                  confirm_body: t("settings.webhooks.confirm_delete.body"),
                                  confirm_verb: t("settings.webhooks.confirm_delete.verb") } } do %>
      <i class="ti ti-trash me-2" aria-hidden="true"></i><%= t("settings.webhooks.actions.delete") %>
    <% end %>
  </div>
</div>
