<% content_for :title, t("settings.webhooks.secret.title") %>

<%= render layout: "settings/shell", locals: { title: t("settings.webhooks.secret.title") } do %>
  <div class="card">
    <div class="card-body">
      <p><%= t("settings.webhooks.secret.intro", host: @endpoint.host) %></p>
      <div class="alert alert-warning" role="note"><%= t("settings.webhooks.secret.once") %></div>
      <div class="input-group mb-4" data-controller="clipboard"
           data-clipboard-copied-label-value="<%= t("settings.api_tokens.created.copied") %>">
        <input type="text" id="webhook_secret" class="form-control font-monospace" readonly
               value="<%= @endpoint.secret %>" data-clipboard-target="source"
               aria-label="<%= t("settings.webhooks.secret.label") %>">
        <button type="button" class="btn" data-action="clipboard#copy">
          <i class="ti ti-copy me-1" aria-hidden="true"></i><span data-clipboard-target="label"><%= t("settings.api_tokens.created.copy_button") %></span>
        </button>
      </div>
      <p class="text-secondary"><%= t("settings.webhooks.secret.verify_html", link: link_to(t("settings.api.reference_link"), developers_api_path)) %></p>
      <%= link_to t("settings.api_tokens.created.done"), settings_webhook_path(@endpoint), class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
