<% content_for :title, t("settings.totps.new.title") %>

<%= render layout: "settings/shell", locals: { title: t("settings.totps.new.title") } do %>
  <div class="card">
    <div class="card-body">
      <ol class="mb-4 ps-3">
        <li class="mb-3">
          <p class="mb-2"><%= t("settings.totps.new.step_scan") %></p>
          <div class="totp-qr bg-white p-2 rounded border d-inline-block" aria-label="<%= t("settings.totps.new.qr_label") %>">
            <%= @qr_svg.html_safe %>
          </div>
        </li>
        <li class="mb-3">
          <p class="mb-1"><%= t("settings.totps.new.step_manual") %></p>
          <code class="user-select-all fs-3"><%= @secret.scan(/.{1,4}/).join(" ") %></code>
        </li>
        <li>
          <p class="mb-2"><%= t("settings.totps.new.step_code") %></p>
          <%= form_with url: settings_totp_path do |form| %>
            <fieldset class="d-flex flex-wrap align-items-center gap-3">
              <legend class="visually-hidden"><%= t("settings.totps.new.code") %></legend>
              <div class="otp" data-controller="otp">
                <%= form.text_field :code, value: nil, required: true, maxlength: 6, size: nil,
                      autocomplete: "one-time-code", aria: { label: t("settings.totps.new.code") } %>
              </div>
              <%= form.submit t("settings.totps.new.submit"), class: "btn btn-primary" %>
            </fieldset>
          <% end %>
        </li>
      </ol>
      <%= link_to t("settings.totps.new.cancel"), settings_security_path %>
    </div>
  </div>
<% end %>
