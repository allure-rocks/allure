<% content_for :title, t("settings.assistant.title") %>

<%= render layout: "settings/shell", locals: { title: t("settings.assistant.title") } do %>
  <%= form_with model: @user, url: settings_assistant_path, method: :patch do |form| %>
    <%= render "shared/form_errors", form: form %>

    <div class="card mb-3">
      <div class="card-header">
        <h2 class="card-title h3"><%= t("settings.assistant.summary_title") %></h2>
      </div>
      <div class="card-body">
        <p class="text-secondary"><%= t("settings.assistant.description") %></p>
        <label class="form-check form-switch">
          <%= form.check_box :ai_enabled, class: "form-check-input", role: "switch" %>
          <span class="form-check-label"><%= t("settings.assistant.enrichment_label") %></span>
        </label>
        <p class="text-secondary mt-3 mb-0">
          <i class="ti ti-shield-lock me-1" aria-hidden="true"></i><%= t("assistant.notice") %> <%= t("settings.assistant.privacy") %>
        </p>
      </div>
      <div class="card-footer">
        <%= form.submit t("settings.assistant.save"), class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>

  <div class="card">
    <div class="card-body">
      <h3 class="card-title"><%= t("settings.assistant.stored.title") %></h3>
      <p class="text-secondary"><%= t("settings.assistant.stored.description", count: @stored_count) %></p>
      <%= button_to t("settings.assistant.stored.action"), settings_assistant_path, method: :delete,
            class: "btn btn-outline-danger", disabled: @stored_count.zero?,
            form: { data: {
              confirm_title: t("settings.assistant.stored.confirm_title"),
              confirm_body: t("settings.assistant.stored.confirm_body", count: @stored_count),
              confirm_verb: t("settings.assistant.stored.action")
            } } %>
    </div>
  </div>
<% end %>
