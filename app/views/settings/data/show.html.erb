<% content_for :title, t("settings.data.title") %>

<%= render layout: "settings/shell", locals: { title: t("settings.data.title") } do %>

  <p class="text-secondary"><%= t("settings.data.subtitle") %></p>

  <turbo-frame id="settings-data-live"
               data-controller="live-frame"
               data-live-frame-url-value="<%= settings_data_path %>"
               data-live-frame-interval-value="6000">
    <%= render "settings/data/live", counts: @counts, elevation_available: @elevation_available, weather_available: @weather_available, summaries_available: @summaries_available %>
  </turbo-frame>
<% end %>
