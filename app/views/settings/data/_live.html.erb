<%# Live counters fragment, re-rendered in place by live_frame_controller.
    Every count is scoped to the current account's workouts
    (PLAN_DERIVATIONS.md §7); the buttons stay disabled while nothing is
    pending. %>
<p class="text-secondary small" role="status" aria-live="polite">
  <%= t("settings.data.live_hint", time: l(Time.current, format: :short)) %>
</p>

<div class="row row-deck row-cards">
  <div class="col-md-6">
    <div class="card">
      <div class="card-body">
        <h3 class="card-title"><%= t("settings.data.rebuild.title") %></h3>
        <p class="text-secondary"><%= t("settings.data.rebuild.description") %></p>
        <p class="mb-3"><%= t("settings.data.count", count: counts.fetch("rebuild")) %></p>
        <%= button_to t("settings.data.rebuild.action"), settings_data_rebuild_path,
              class: "btn btn-outline-primary",
              disabled: counts.fetch("rebuild").zero?,
              form: { data: {
                turbo_frame: "_top",
                confirm_title: t("settings.data.rebuild.confirm_title"),
                confirm_body: t("settings.data.rebuild.confirm_body", count: counts.fetch("rebuild")),
                confirm_verb: t("settings.data.rebuild.action")
              } } %>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card">
      <div class="card-body">
        <h3 class="card-title"><%= t("settings.data.route_images.title") %></h3>
