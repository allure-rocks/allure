                confirm_verb: t("settings.data.route_images.action")
              } } %>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card">
      <div class="card-body">
        <h3 class="card-title"><%= t("settings.data.segment_images.title") %></h3>
        <p class="text-secondary"><%= t("settings.data.segment_images.description") %></p>
        <p class="mb-3"><%= t("settings.data.segment_count", count: counts.fetch("segment_images")) %></p>
        <%= button_to t("settings.data.segment_images.action"), settings_data_segment_images_path,
