<% content_for :title, t("admin.imports.title") %>

<% content_for :page_header do %>
  <div class="page-pretitle"><%= t("admin.pretitle") %></div>
  <h1 class="page-title"><%= t("admin.imports.title") %></h1>
<% end %>

<div class="card mb-3">
  <div class="card-header">
    <%= render "admin/imports/tabs", current: :batches %>
  </div>
  <div class="card-body">
    <%= form_with url: admin_imports_path, method: :get, class: "row g-2 align-items-end" do %>
      <div class="col-auto">
        <%= label_tag :source, t("admin.imports.filters.source"), class: "form-label" %>
        <%= select_tag :source,
              options_for_select(
                [ [ t("admin.imports.filters.all"), "" ] ] +
                  WorkoutImportBatch::SOURCES.map { |key| [ t("workouts.batch_import.sources.#{key}.label"), key ] },
                @source
              ),
              class: "form-select" %>
      </div>
      <div class="col-auto">
        <%= label_tag :status, t("admin.imports.filters.status"), class: "form-label" %>
        <%= select_tag :status,
              options_for_select(
                [ [ t("admin.imports.filters.all"), "" ] ] +
                  WorkoutImportBatch::STATUSES.map { |value| [ t("workouts.batch_import.status.labels.#{value}"), value ] },
                @status
              ),
              class: "form-select" %>
      </div>
      <div class="col-auto">
        <%= submit_tag t("admin.imports.filters.apply"), class: "btn btn-outline-primary" %>
      </div>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-sm card-table">
      <thead>
        <tr>
          <th scope="col"><%= t("admin.imports.table.owner") %></th>
          <th scope="col"><%= t("admin.imports.table.source") %></th>
          <th scope="col"><%= t("admin.imports.table.trigger") %></th>
          <th scope="col"><%= t("admin.imports.table.status") %></th>
          <th scope="col" class="text-end"><%= t("admin.imports.table.total") %></th>
          <th scope="col" class="text-end"><%= t("admin.imports.table.imported") %></th>
          <th scope="col" class="text-end"><%= t("admin.imports.table.failed") %></th>
          <th scope="col" class="text-end"><%= t("admin.imports.table.duplicates") %></th>
          <th scope="col"><%= t("admin.imports.table.created_at") %></th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody>
        <% @batches.each do |batch| %>
          <tr>
            <td class="text-secondary">@<%= batch.user.username %></td>
            <td><%= t("workouts.batch_import.sources.#{batch.source}.label") %></td>
            <td class="text-secondary"><%= t("admin.imports.triggers.#{batch.trigger}") %></td>
            <td>
              <span class="badge <%= batch.status == "failed" ? "bg-danger-lt" : "bg-secondary-lt" %>">
                <%= t("workouts.batch_import.status.labels.#{batch.status}") %>
              </span>
            </td>
            <td class="text-end"><%= batch.total_entries %></td>
            <td class="text-end"><%= batch.imported_entries %></td>
            <td class="text-end <%= "text-danger" if batch.failed_entries.positive? %>"><%= batch.failed_entries %></td>
            <td class="text-end"><%= batch.duplicate_entries %></td>
            <td class="text-secondary"><%= l(batch.created_at, format: :long) %></td>
            <td class="text-end">
              <%= link_to t("admin.imports.table.details"), admin_import_path(batch), class: "btn btn-sm btn-outline-secondary" %>
            </td>
          </tr>
        <% end %>
        <% if @batches.empty? %>
          <tr><td colspan="10" class="text-secondary"><%= t("admin.imports.empty") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @pagy.pages > 1 %>
    <div class="card-footer d-flex justify-content-center">
      <%== pagy_bootstrap_nav(@pagy) %>
    </div>
  <% end %>
</div>
