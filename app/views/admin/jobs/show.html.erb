<% content_for :title, t("admin.jobs.title") %>

<% content_for :page_header do %>
  <div class="page-pretitle"><%= t("admin.pretitle") %></div>
  <h1 class="page-title"><%= t("admin.jobs.title") %></h1>
<% end %>

<turbo-frame id="admin-jobs-live"
             data-controller="live-frame"
             data-live-frame-url-value="<%= admin_jobs_path %>"
             data-live-frame-interval-value="4000">
  <%= render "admin/jobs/live", snapshot: @snapshot %>
</turbo-frame>

<%# Outside the polling frame: these counts are workout-table queries and do
    not need to refresh every few seconds. docs/dev/DERIVATIONS.md %>
<div class="card mt-3">
  <div class="card-header">
    <h2 class="card-title"><%= t("admin.jobs.rebuild.title") %></h2>
  </div>
  <div class="card-body">
    <% if @rebuild_count.positive? %>
      <p class="mb-3"><%= t("admin.jobs.rebuild.outdated", count: @rebuild_count) %></p>
      <%= button_to t("admin.jobs.rebuild.action"), admin_jobs_rebuild_path,
            class: "btn btn-outline-primary",
            form: { data: {
              turbo_frame: "_top",
              confirm_title: t("admin.jobs.rebuild.confirm_title"),
              confirm_body: t("admin.jobs.rebuild.confirm_body", count: @rebuild_count),
              confirm_verb: t("admin.jobs.rebuild.action")
            } } %>
    <% else %>
      <p class="mb-0 text-secondary"><%= t("admin.jobs.rebuild.current") %></p>
    <% end %>
  </div>
</div>

