<% content_for :title, t("admin.publications.title") %>

<% content_for :page_header do %>
  <div class="page-pretitle"><%= t("admin.pretitle") %></div>
  <h1 class="page-title"><%= t("admin.publications.title") %></h1>
<% end %>

<div class="card mb-3">
  <div class="card-header">
    <%# Navigation links between publication kinds, not an ARIA tab widget:
        the current one carries `aria-current="page"` (DESIGN.md §10.15). %>
    <ul class="nav nav-tabs card-header-tabs" aria-label="<%= t("admin.publications.tabs.label") %>">
      <li class="nav-item">
        <%= link_to t("admin.publications.tabs.workouts"),
              admin_publications_path(kind: "workouts", status: @status, audience: @audience),
              class: class_names("nav-link", active: @kind == "workouts"),
              aria: { current: (@kind == "workouts" ? "page" : nil) } %>
      </li>
      <li class="nav-item">
        <%= link_to t("admin.publications.tabs.courses"),
              admin_publications_path(kind: "courses", status: @status, audience: @audience),
              class: class_names("nav-link", active: @kind == "courses"),
              aria: { current: (@kind == "courses" ? "page" : nil) } %>
      </li>
    </ul>
  </div>
  <div class="card-body">
    <%= form_with url: admin_publications_path, method: :get, class: "row g-2 align-items-end" do %>
      <%= hidden_field_tag :kind, @kind %>
      <div class="col-auto">
        <%= label_tag :status, t("admin.publications.filters.status"), class: "form-label" %>
        <%= select_tag :status,
              options_for_select(@statuses.map { |value| [ t("admin.publications.statuses.#{value}"), value ] }, @status),
              class: "form-select" %>
      </div>
      <div class="col-auto">
        <%= label_tag :audience, t("admin.publications.filters.audience"), class: "form-label" %>
        <%= select_tag :audience,
              options_for_select(@audiences.map { |value| [ t("admin.publications.audiences.#{value}"), value ] }, @audience),
              class: "form-select" %>
      </div>
      <div class="col-auto">
        <%= submit_tag t("admin.publications.filters.apply"), class: "btn btn-outline-primary" %>
      </div>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-sm card-table">
      <thead>
        <tr>
          <th scope="col"><%= t("admin.publications.table.owner") %></th>
          <th scope="col"><%= t("admin.publications.table.publication") %></th>
          <th scope="col"><%= t("admin.publications.table.audience") %></th>
          <th scope="col"><%= t("admin.publications.table.status") %></th>
          <th scope="col"><%= t("admin.publications.table.published_at") %></th>
          <th scope="col"><%= t("admin.publications.table.delivery") %></th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody>
        <% @publications.each do |publication| %>
          <% owner = @kind == "courses" ? publication.segment&.user : publication.workout&.user %>
          <% title = @kind == "courses" ? (publication.segment&.name || publication.representation["name"]) : (publication.workout&.title || publication.publication_title) %>
          <% delivery = @delivery[publication.id] %>
          <% scheduled = @kind == "workouts" && publication.scheduled? %>
          <tr>
            <td class="text-secondary">@<%= owner&.username || publication.actor&.handle %></td>
            <td><%= title.presence || t("admin.publications.untitled") %></td>
            <td>
              <%= publication_badge(publication.audience) %>
            </td>
            <td>
              <% if publication.active? %>
                <span class="badge bg-success-lt"><%= t("admin.publications.statuses.active") %></span>
              <% elsif scheduled %>
                <span class="badge bg-warning-lt"><%= t("admin.publications.statuses.scheduled") %></span>
              <% else %>
                <span class="badge bg-secondary-lt"><%= t("admin.publications.statuses.deleted") %></span>
              <% end %>
            </td>
            <td class="text-secondary">
              <% if scheduled %>
                <%= t("admin.publications.scheduled_for", time: l(publication.scheduled_for, format: :long)) %>
              <% else %>
                <%= l(publication.published_at, format: :long) %>
              <% end %>
            </td>
            <td class="text-secondary small">
              <% if delivery && delivery.values.any?(&:positive?) %>
                <%= t("admin.publications.delivery", delivered: delivery[:delivered], open: delivery[:open], failed: delivery[:failed]) %>
              <% else %>
                —
              <% end %>
            </td>
            <td class="text-end">
              <% withdraw_path = @kind == "courses" ? admin_course_publication_withdraw_path(publication) : admin_workout_publication_withdraw_path(publication) %>
              <% if publication.active? %>
                <%= button_to t("admin.publications.withdraw"), withdraw_path,
                      class: "btn btn-sm btn-outline-danger",
                      form: { data: {
                        confirm_title: t("admin.publications.withdraw_confirm_title"),
                        confirm_body: t("admin.publications.withdraw_confirm_body", title: title.presence || t("admin.publications.untitled")),
                        confirm_verb: t("admin.publications.withdraw")
                      } } %>
              <% elsif scheduled %>
                <%= button_to t("admin.publications.cancel_schedule"), withdraw_path,
                      class: "btn btn-sm btn-outline-danger",
                      form: { data: {
                        confirm_title: t("admin.publications.cancel_schedule_confirm_title"),
                        confirm_body: t("admin.publications.cancel_schedule_confirm_body", title: title.presence || t("admin.publications.untitled")),
                        confirm_verb: t("admin.publications.cancel_schedule")
                      } } %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @publications.empty? %>
          <tr><td colspan="7" class="text-secondary"><%= t("admin.publications.empty") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @pagy.pages > 1 %>
    <div class="card-footer d-flex justify-content-center">
      <%== pagy_bootstrap_nav(@pagy) %>
    </div>
  <% end %>
</div>
