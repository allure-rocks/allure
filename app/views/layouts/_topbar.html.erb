<%# The iOS companion already names the page and its server in the native bar
    (DESIGN.md §7.7): the brand and theme toggle are dropped there, and the
    menu toggle stays for the destinations the bottom bar does not carry.
    When the app registers the `topbar` bridge component, it draws this whole
    bar natively from `native_topbar_payload`; the web bar stays in the page,
    hidden, so the controls the app clicks keep their links and forms. %>
<% native = hotwire_native_app? %>
<% bridged = native && signed_in? && hotwire_native_bridge?(:topbar) %>
<%= tag.header class: class_names("navbar navbar-expand-lg d-print-none", "d-none": bridged),
               data: (bridged ? { controller: "bridge--topbar", bridge__topbar_payload_value: native_topbar_payload.to_json } : {}) do %>
  <div class="container-fluid">
    <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse" data-bs-target="#primary-menu"
            aria-controls="primary-menu" aria-expanded="false"
            aria-label="<%= t("navigation.toggle") %>">
      <span class="navbar-toggler-icon"></span>
    </button>

    <% unless native %>
      <div class="navbar-brand navbar-brand-autodark ms-2 ms-lg-0 me-auto me-lg-5">
        <%= link_to root_path, class: "text-decoration-none allure-brand", aria: { label: t("app.name") } do %>
          <%= render "shared/brand_mark", size: "fs-1" %>
          <%= render "shared/brand_wordmark", responsive: true %>
        <% end %>
      </div>
    <% end %>

    <div class="<%= class_names("navbar-nav flex-row order-lg-last", "ms-auto": native) %>">
      <% if signed_in? %>
        <div class="nav-item ms-3 me-2 d-flex align-items-center">
          <%= link_to new_workout_import_path, class: "btn btn-primary btn-sm topbar-import",
                      data: tooltip_data(t("navigation.import")).merge(bridge_item: "import"),
                      aria: { label: t("navigation.import") } do %>
            <i class="ti ti-plus me-lg-1" aria-hidden="true"></i><span class="d-none d-lg-inline"><%= t("navigation.import") %></span>
          <% end %>
        </div>
        <%= render "notifications/bell" unless enrolment_only_session? %>
        <%= link_to t("notifications.bell.label"), notifications_path, hidden: true,
                    data: { bridge_item: "notifications" } if bridged %>
        <%= render "layouts/theme_toggle" unless native %>
        <%= render "layouts/account_menu" %>
      <% else %>
        <%= render "layouts/theme_toggle" unless native %>
        <div class="nav-item ms-3">
          <%= link_to t("navigation.sign_in"), new_session_path, class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>

    <nav class="collapse navbar-collapse" id="primary-menu" aria-label="<%= t("navigation.primary") %>">
      <% nav_sections.each do |section| %>
        <ul class="navbar-nav">
          <li class="nav-item d-lg-none">
            <span class="nav-link text-uppercase small fw-bold opacity-50 pe-none">
              <%= t("navigation.sections.#{section.key}") %>
            </span>
          </li>
          <%= render partial: "layouts/nav_item", collection: section.items, as: :item %>
        </ul>
      <% end %>
    </nav>
  </div>
<% end %>
