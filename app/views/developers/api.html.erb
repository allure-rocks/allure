<% content_for :title, t("developers.api.title") %>

<% content_for :page_header do %>
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle"><%= t("developers.api.pretitle") %></div>
      <h1 class="page-title"><%= t("developers.api.title") %></h1>
    </div>
    <% unless hotwire_native_app? %>
      <div class="col-auto ms-auto">
        <%= link_to settings_api_path, class: "btn" do %>
          <i class="ti ti-key me-1" aria-hidden="true"></i><%= t("developers.api.tokens_link") %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="row row-cards">
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <p><%= t("developers.api.intro") %></p>
        <div class="row g-3 mb-3">
          <div class="col-lg-7">
            <label class="form-label" for="api_base_url"><%= t("developers.api.base_url") %></label>
            <div class="input-group" data-controller="clipboard"
                 data-clipboard-copied-label-value="<%= t("developers.api.copied") %>">
              <input type="text" id="api_base_url" class="form-control font-monospace" readonly
                     value="<%= @api_base_url %>" data-clipboard-target="source">
              <button type="button" class="btn" data-action="clipboard#copy">
                <i class="ti ti-copy me-1" aria-hidden="true"></i><span data-clipboard-target="label"><%= t("developers.api.copy") %></span>
              </button>
            </div>
          </div>
          <div class="col-lg-5">
            <span class="form-label"><%= t("developers.api.document") %></span>
            <div class="btn-list">
              <%= link_to "openapi.json", api_rest_v1_openapi_path(format: :json), class: "btn btn-outline-secondary" %>
              <%= link_to "openapi.yaml", api_rest_v1_openapi_path(format: :yaml), class: "btn btn-outline-secondary" %>
            </div>
          </div>
        </div>
        <p class="text-secondary mb-3"><%= t("developers.api.authentication_html", header: tag.code("Authorization: Bearer allure_pat_…")) %></p>
        <div class="alert alert-warning mb-0" role="note"><%= t("settings.api_tokens.new.warning") %></div>
      </div>
    </div>
  </div>

  <div class="col-12">
    <div class="card">
      <iframe src="<%= developers_api_reference_path %>"
              title="<%= t("developers.api.reference_title") %>"
              class="api-reference-frame"
              data-controller="api-reference-frame"
              data-action="load->api-reference-frame#sync"></iframe>
    </div>
  </div>
</div>
