<% if @items.any? %>
  <noscript>
    <% if @pagy.last > 1 %>
      <div class="d-flex justify-content-center mb-3"><%== pagy_bootstrap_compact_nav(@pagy) %></div>
    <% end %>
  </noscript>
  <div data-controller="infinite-scroll"
       data-infinite-scroll-url-value="<%= @pagy.next ? pagy_url_for(@pagy, @pagy.next) : "" %>">
    <div data-infinite-scroll-target="items">
      <%= render partial: "feeds/item", collection: @items, as: :item, locals: { show_author: false, editorial: true } %>
    </div>
    <div class="text-center py-3" data-infinite-scroll-target="sentinel" aria-hidden="true">
      <%= render "feeds/skeleton", editorial: true if @pagy.next %>
    </div>
  </div>
  <noscript>
    <% if @pagy.last > 1 %>
      <div class="d-flex justify-content-center mt-3"><%== pagy_bootstrap_nav(@pagy) %></div>
    <% end %>
  </noscript>
<% else %>
  <div class="card">
    <div class="card-body">
      <div class="empty">
        <div class="empty-icon"><i class="ti ti-activity fs-1 text-secondary" aria-hidden="true"></i></div>
        <% key = @journal.filtered? ? "profile.filtered_empty" : "profile.empty" %>
        <p class="empty-title"><%= t("#{key}.title") %></p>
        <p class="empty-subtitle text-secondary"><%= t("#{key}.subtitle") %></p>
      </div>
    </div>
  </div>
<% end %>
