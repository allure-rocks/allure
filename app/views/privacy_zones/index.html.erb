<% content_for :title, t("privacy_zones.index.title") %>

<% content_for :settings_actions do %>
  <%= link_to new_privacy_zone_path, class: "btn btn-primary" do %>
    <i class="ti ti-plus me-1"></i><%= t("privacy_zones.index.new_button") %>
  <% end %>
<% end %>

<%= render layout: "settings/shell", locals: { title: t("privacy_zones.index.title") } do %>

  <div class="row row-deck row-cards">
    <div class="col-12">
      <%= render "privacy_zones/panel" %>
    </div>
  </div>

  <% if @privacy_zones.any? %>
    <div class="card">
      <div class="table-responsive">
        <table class="table table-sm table-vcenter card-table">
          <caption class="visually-hidden"><%= t("privacy_zones.index.title") %></caption>
          <thead>
            <tr>
              <th scope="col"><%= t("privacy_zones.index.table.zone") %></th>
              <th scope="col" class="text-end"><%= t("privacy_zones.fields.radius") %></th>
              <th scope="col" class="d-none d-md-table-cell ps-4"><%= t("privacy_zones.fields.center") %></th>
              <th scope="col"><span class="visually-hidden"><%= t("privacy_zones.index.table.actions") %></span></th>
            </tr>
          </thead>
          <tbody>
            <% @privacy_zones.each do |zone| %>
              <% name = zone.name.presence || t("privacy_zones.unnamed") %>
              <tr class="<%= "text-secondary" unless zone.active? %>">
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <span class="avatar avatar-sm <%= zone.active? ? "bg-primary-lt" : "bg-secondary-lt" %> d-none d-sm-inline-flex" aria-hidden="true">
                      <i class="ti ti-shield-lock"></i>
                    </span>
                    <div class="min-width-0">
                      <%= link_to name, edit_privacy_zone_path(zone), class: "text-reset text-break d-block fw-medium" %>
                      <% unless zone.active? %>
                        <span class="badge bg-secondary-lt mt-1"><%= t("privacy_zones.status.inactive") %></span>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="text-end text-nowrap"><%= number_with_delimiter(zone.radius_meters) %> <%= t("privacy_zones.units.meters") %></td>
                <td class="d-none d-md-table-cell ps-4 text-secondary text-nowrap">
                  <%= number_with_precision(zone.latitude, precision: 5) %>, <%= number_with_precision(zone.longitude, precision: 5) %>
                </td>
                <td class="text-end">
                  <div class="d-flex justify-content-end gap-1">
                    <%= link_to edit_privacy_zone_path(zone), class: "btn btn-sm btn-ghost-secondary btn-icon",
                          aria: { label: "#{t("privacy_zones.actions.edit")} : #{name}" },
                          title: t("privacy_zones.actions.edit") do %>
                      <i class="ti ti-pencil" aria-hidden="true"></i>
                    <% end %>
                    <%= button_to privacy_zone_path(zone),
                          method: :delete, class: "btn btn-sm btn-ghost-danger btn-icon",
                          aria: { label: "#{t("privacy_zones.actions.delete")} : #{name}" },
                          title: t("privacy_zones.actions.delete"),
                          form: { data: {
                            confirm_title: t("privacy_zones.actions.confirm.title"),
                            confirm_body: t("privacy_zones.actions.confirm.body"),
                            confirm_verb: t("privacy_zones.actions.confirm.verb")
                          } } do %>
                      <i class="ti ti-trash" aria-hidden="true"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="card">
      <div class="card-body">
        <div class="empty">
          <div class="empty-icon"><i class="ti ti-shield-lock fs-1 text-primary"></i></div>
          <p class="empty-title"><%= t("privacy_zones.empty.title") %></p>
          <p class="empty-subtitle text-secondary"><%= t("privacy_zones.empty.subtitle") %></p>
          <div class="empty-action"><%= link_to t("privacy_zones.index.new_button"), new_privacy_zone_path, class: "btn btn-primary" %></div>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
