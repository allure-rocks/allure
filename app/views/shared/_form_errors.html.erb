<%# Validation summary (DESIGN.md §14.2): every error as a link to its field,
    announced via role="alert" and focused on render through autofocus. %>
<% if form.object.errors.any? %>
  <div class="alert alert-danger" role="alert" tabindex="-1" autofocus data-unsaved-changes="forced">
    <h4 class="alert-title"><%= t("forms.errors.title") %></h4>
    <ul class="mb-0">
      <% form.object.errors.each do |error| %>
        <li>
          <% if error.attribute == :base %>
            <%= error.full_message %>
          <% else %>
            <%= link_to error.full_message, "##{form.field_id(error.attribute)}", class: "alert-link" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
