<% content_for :title, t("equipments.edit.title") %>

<% content_for :page_header do %>
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle"><%= t("equipments.edit.pretitle") %></div>
      <h1 class="page-title"><%= t("equipments.edit.title") %></h1>
    </div>
  </div>
<% end %>

<%= form_with model: @equipment, url: equipment_path(@equipment), method: :patch do |form| %>
  <%= render "form", form: form %>
<% end %>
