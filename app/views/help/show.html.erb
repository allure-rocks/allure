<% content_for :title, t("help.topics.#{@topic}.title") %>

<% content_for :page_header do %>
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle"><%= link_to t("help.index.title"), help_path %></div>
      <h1 class="page-title"><%= t("help.topics.#{@topic}.title") %></h1>
    </div>
  </div>
<% end %>

<div class="row row-cards">
  <div class="col-lg-8">
    <article class="card">
      <div class="card-body markdown help-article">
        <%= render "help/topics/#{@topic}" %>
      </div>
    </article>
  </div>
</div>
