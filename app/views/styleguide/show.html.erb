<% content_for :title, t("styleguide.title") %>

<% content_for :page_header do %>
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle"><%= t("styleguide.pretitle") %></div>
      <h1 class="page-title"><%= t("styleguide.title") %></h1>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <div class="btn-list">
        <% I18n.available_locales.each do |locale| %>
          <%= link_to locale.to_s.upcase, styleguide_path(locale:), lang: locale, class: "btn btn-sm #{I18n.locale == locale ? 'btn-primary' : 'btn-outline-secondary'}" %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div class="card mb-3">
  <div class="card-body text-secondary"><%= t("styleguide.intro") %></div>
</div>

<div class="card mb-3" id="sg-cards">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.cards") %></h2></div>
  <div class="card-body">
    <div class="row row-deck row-cards">
      <div class="col-md-6">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title"><%= t("styleguide.sections.cards") %></h3>
            <div class="card-actions"><span class="btn btn-sm btn-ghost-secondary"><%= t("styleguide.buttons.ghost") %></span></div>
          </div>
          <div class="card-body"><%= t("styleguide.alerts.info") %></div>
          <div class="card-footer"><%= t("styleguide.states.loading") %></div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card">
          <div class="card-body">
            <div class="empty">
              <div class="empty-icon"><i class="ti ti-route fs-1 text-primary"></i></div>
              <p class="empty-title"><%= t("styleguide.states.empty_new") %></p>
              <div class="empty-action"><span class="btn btn-primary"><%= t("styleguide.states.empty_new_action") %></span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card mb-3" id="sg-tiles">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.tiles") %></h2></div>
  <div class="card-body">
    <div class="row row-deck row-cards">
      <div class="col-6 col-md-4">
        <div class="card"><div class="card-body">
          <div class="text-secondary small text-uppercase"><%= t("styleguide.tiles.distance") %></div>
          <div class="h2 mb-0 allure-table-nums">42,2 <small class="text-secondary fw-normal">km</small></div>
        </div></div>
      </div>
      <div class="col-6 col-md-4">
        <div class="card"><div class="card-body">
          <div class="text-secondary small text-uppercase"><%= t("styleguide.tiles.ascent") %></div>
          <div class="h2 mb-0 allure-table-nums">1 180 <small class="text-secondary fw-normal">m</small></div>
        </div></div>
      </div>
      <div class="col-6 col-md-4">
        <div class="card"><div class="card-body">
          <div class="text-secondary small text-uppercase"><%= t("styleguide.tiles.heart_rate") %></div>
          <div class="h2 mb-0" aria-label="<%= t("styleguide.tiles.absent") %>">—</div>
        </div></div>
      </div>
    </div>
  </div>
</div>

<div class="card mb-3" id="sg-buttons">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.buttons") %></h2></div>
  <div class="card-body">
    <div class="btn-list">
      <span class="btn btn-primary"><%= t("styleguide.buttons.primary") %></span>
      <span class="btn btn-outline-secondary"><%= t("styleguide.buttons.secondary") %></span>
      <span class="btn btn-ghost-secondary"><%= t("styleguide.buttons.ghost") %></span>
      <span class="btn btn-outline-danger"><%= t("styleguide.buttons.danger") %></span>
      <%= tag.span class: "btn btn-ghost-secondary btn-icon", aria: { label: t("styleguide.buttons.icon_label") },
            data: tooltip_data(t("styleguide.buttons.icon_label")) do %>
        <i class="ti ti-pencil"></i>
      <% end %>
    </div>
    <div class="text-secondary small mt-3 mb-1"><%= t("styleguide.buttons.header_actions") %></div>
    <div class="btn-list">
      <span class="btn btn-sm btn-outline-primary"><%= t("styleguide.buttons.secondary") %></span>
      <span class="btn btn-sm btn-primary"><%= t("styleguide.buttons.primary") %></span>
    </div>
    <div class="text-secondary small mt-3 mb-1"><%= t("styleguide.buttons.form_actions") %></div>
    <div class="allure-actions">
      <span class="btn btn-primary"><%= t("styleguide.buttons.primary") %></span>
      <span class="btn btn-link"><%= t("styleguide.buttons.cancel") %></span>
    </div>
  </div>
</div>

<div class="card mb-3" id="sg-badges">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.badges") %></h2></div>
  <div class="card-body">
    <div class="btn-list mb-2">
      <% if @sports.any? %>
        <% demo_sport = @sports.find { |s| s.slug == "running" } || @sports.first %>
        <span class="d-inline-flex align-items-center gap-2"><%= sport_tile_tag(demo_sport, size: :sm) %><%= sport_display_name(demo_sport) %></span>
      <% end %>
      <%= personal_place_badge(1, tooltip: t("medals.records", records: t("records.types.fd"), count: 1),
                                  text: t("workouts.show.records.badge_short"), extra_classes: "allure-record-badge") %>
    </div>
    <%# The state badges (DESIGN.md §10.4): the publication state, the viewer's
        own item and an activity done with someone, the label printed from `md`
        up and the icon alone below it. The second row is the icon-only form
        the cards and phone rows carry. %>
    <% publication_states = [ [ "public" ], [ "followers" ], [ "scheduled", "public" ], [ "scheduled", "followers" ], [ "unpublished" ] ] %>
    <% together_label = t("workouts.participations.badge", name: "Marie") %>
    <% detached_label = t("workouts.credit.badge_detached", name: "Marie") %>
    <% group_names = %w[Marie Paul Eva Joan] %>
    <div class="btn-list mb-2">
      <% publication_states.each do |state, audience| %>
        <%= publication_badge(state, audience:) %>
      <% end %>
      <%= mine_badge(label: t("segments.card.mine")) %>
      <%= together_badge(together_label) %>
      <%= together_badge(together_badge_text(group_names), tooltip: together_badge_text(group_names, full: true)) %>
      <%= together_badge(detached_label, detached: true) %>
    </div>
    <div class="btn-list mb-2">
      <span class="text-secondary small align-self-center"><%= t("styleguide.badges.icon_only") %></span>
      <% publication_states.each do |state, audience| %>
        <%= publication_badge(state, audience:, fit: :icon) %>
      <% end %>
      <%= mine_badge(label: t("segments.card.mine"), fit: :icon) %>
      <%= together_badge(together_label, fit: :icon) %>
      <%= together_badge(together_badge_text(group_names), tooltip: together_badge_text(group_names, full: true), fit: :icon) %>
      <%= together_badge(detached_label, detached: true, fit: :icon) %>
    </div>
    <%# The two shapes of DESIGN.md §10.4: the trophy against yourself, the
        laurel against others; the colour is the place. %>
    <div class="btn-list mb-2">
      <% [ [ 1, "record" ], [ 2, "second_best" ], [ 3, "third_best" ] ].each do |place, key| %>
        <span class="d-inline-flex align-items-center gap-2">
          <%= personal_place_icon(place, t("records.distances.km10")) %><%= t("styleguide.medals.#{key}") %>
        </span>
      <% end %>
      <% [ 1, 2, 3 ].each do |place| %>
        <%= personal_place_badge(place, tooltip: personal_place_label(place, t("records.distances.km10"))) %>
      <% end %>
    </div>
    <div class="btn-list mb-2">
      <% [ [ 1, "first" ], [ 2, "second" ], [ 3, "third" ], [ 4, "plain" ] ].each do |rank, key| %>
        <span class="d-inline-flex align-items-center gap-2"><%= rank_medal(rank) %><%= t("styleguide.medals.#{key}") %></span>
      <% end %>
    </div>
    <div class="btn-list mb-2">
      <span class="badge bg-success-lt"><i class="ti ti-check me-1"></i><%= t("workouts.batch_import.entries.labels.imported") %></span>
      <span class="badge bg-danger-lt"><i class="ti ti-x me-1"></i><%= t("workouts.batch_import.entries.labels.failed") %></span>
      <span class="badge bg-secondary-lt"><%= t("workouts.batch_import.entries.labels.duplicate") %></span>
      <span class="badge bg-secondary-lt"><%= t("workouts.batch_import.entries.labels.cancelled") %></span>
    </div>
    <div class="btn-list">
      <span class="badge bg-success-lt"><%= t("equipments.details.active") %></span>
      <span class="badge bg-secondary-lt"><%= t("equipments.details.inactive") %></span>
      <span class="badge bg-primary-lt"><i class="ti ti-route me-1"></i><%= t("segments.index.kinds.segment") %></span>
      <span class="badge bg-primary-lt"><i class="ti ti-route-2 me-1"></i><%= t("segments.index.kinds.route") %></span>
      <span class="badge bg-primary-lt"><i class="ti ti-repeat me-1"></i><%= t("segments.index.kinds.loop") %></span>
    </div>
  </div>
</div>

<div class="card mb-3" id="sg-avatars">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.avatars") %></h2></div>
  <div class="card-body">
    <div class="d-flex align-items-center gap-2">
      <% demo_account = User.new(username: "alpine", display_name: "Alpine Skier", email_address: "alpine@example.test") %>
      <%= avatar_tag(demo_account, size: "xs") %>
      <%= avatar_tag(demo_account, size: "sm") %>
      <%= avatar_tag(demo_account, size: "md") %>
      <%= avatar_tag(demo_account, size: "lg") %>
      <%= avatar_tag(demo_account, size: "xl") %>
      <span class="ms-2">Alpine Skier</span>
    </div>
    <div class="d-flex align-items-center gap-2 mt-3">
      <% %w[alpine marie paul].each do |name| %>
        <% demo = User.new(username: name, display_name: name.capitalize, email_address: "#{name}@example.test") %>
        <%= avatar_tag(demo, size: "lg") %>
      <% end %>
      <span class="ms-2"><%= t("styleguide.avatars_seeds") %></span>
    </div>
  </div>
</div>

<div class="card mb-3" id="sg-tables">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.tables") %></h2></div>
  <div class="table-responsive d-none d-md-block">
    <table class="table table-sm table-vcenter card-table allure-table-nums">
      <caption class="visually-hidden"><%= t("styleguide.sections.tables") %></caption>
      <thead>
        <tr>
          <th scope="col"><%= t("styleguide.tiles.distance") %></th>
          <th scope="col" class="text-end"><%= t("styleguide.tiles.ascent") %></th>
        </tr>
      </thead>
      <tbody>
        <tr><td>42,2 km</td><td class="text-end">1 180 m</td></tr>
      </tbody>
    </table>
  </div>
  <ul class="list-group list-group-flush d-md-none allure-card-list">
    <li class="list-group-item">
      <div class="d-flex justify-content-between align-items-baseline">
        <span class="allure-card-title">42,2 km</span>
        <strong class="allure-table-nums">1 180 m</strong>
      </div>
    </li>
  </ul>
</div>

<div class="card mb-3" id="sg-filters">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.filters") %></h2></div>
  <div class="card-body d-flex flex-column gap-3">
    <div>
      <h3 class="h4"><%= t("styleguide.filters.open_title") %></h3>
      <div class="allure-filter-bar">
        <div class="card mb-3">
          <div class="card-body">
            <div class="d-flex flex-wrap gap-2 align-items-end">
              <div>
                <label class="form-label" for="sg-sport"><%= t("styleguide.filters.sport") %></label>
                <select class="form-select form-select-sm" id="sg-sport">
                  <option><%= t("styleguide.filters.all_sports") %></option>
                </select>
              </div>
              <div>
                <label class="form-label" for="sg-search"><%= t("styleguide.filters.search_label") %></label>
                <input class="form-control form-control-sm" id="sg-search" type="search" placeholder="<%= t("styleguide.filters.search_placeholder") %>">
              </div>
            </div>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
          <span class="badge bg-primary-lt"><%= t("styleguide.filters.chip") %>
            <span class="ms-1" role="button" tabindex="0" aria-label="<%= t("styleguide.filters.remove_chip") %>"><i class="ti ti-x"></i></span>
          </span>
          <span class="btn btn-sm btn-ghost-secondary"><%= t("styleguide.filters.clear") %></span>
          <span class="ms-auto text-secondary small" aria-live="polite"><%= t("styleguide.filters.count") %></span>
        </div>
      </div>
    </div>
    <div>
      <h3 class="h4"><%= t("styleguide.filters.retracted_title") %></h3>
      <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
        <span class="h3 mb-0 me-auto"><%= t("styleguide.filters.bar_title") %></span>
        <button class="filter-toggle btn btn-sm btn-outline-secondary" type="button"
                data-bs-toggle="collapse" data-bs-target="#sg-filters-body"
                aria-controls="sg-filters-body" aria-expanded="false">
          <i class="ti ti-filter me-1" aria-hidden="true"></i>
          <%= t("styleguide.filters.toggle") %>
          <span class="badge bg-primary-lt ms-1">1</span>
        </button>
        <span class="btn btn-sm btn-outline-secondary"><%= t("workouts.index.view.card") %></span>
        <span class="btn btn-sm btn-primary"><%= t("workouts.index.view.table") %></span>
      </div>
      <div class="allure-filter-bar">
        <div class="collapse" id="sg-filters-body">
          <div class="card mb-3">
            <div class="card-body">
              <div class="d-flex flex-wrap gap-2 align-items-end">
                <div>
                  <label class="form-label" for="sg-filter-sport"><%= t("styleguide.filters.sport") %></label>
                  <select class="form-select form-select-sm" id="sg-filter-sport">
                    <option><%= t("styleguide.filters.all_sports") %></option>
                  </select>
                </div>
                <div>
                  <label class="form-label" for="sg-filter-from"><%= t("styleguide.filters.from") %></label>
                  <input class="form-control form-control-sm" id="sg-filter-from" type="date" disabled>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
          <span class="badge bg-primary-lt"><%= t("styleguide.filters.chip") %>
            <span class="ms-1" role="button" tabindex="0" aria-label="<%= t("styleguide.filters.remove_chip") %>"><i class="ti ti-x"></i></span>
          </span>
          <span class="ms-auto text-secondary small" aria-live="polite"><%= t("styleguide.filters.count") %></span>
        </div>
        <noscript>
          <style>
            #sg-filters-body.collapse:not(.show) { display: block; }
            .filter-toggle { display: none; }
          </style>
        </noscript>
      </div>
    </div>
  </div>
</div>

<div class="card mb-3" id="sg-alerts">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.alerts") %></h2></div>
  <div class="card-body d-flex flex-column gap-2">
    <div class="alert alert-success" role="alert"><%= t("styleguide.alerts.success") %></div>
    <div class="alert alert-warning" role="alert"><%= t("styleguide.alerts.warning") %></div>
    <div class="alert alert-danger" role="alert"><%= t("styleguide.alerts.danger") %></div>
    <div class="alert alert-info" role="note"><%= t("segments.leaderboard.residual_risk") %></div>
  </div>
</div>

<div class="card mb-3" id="sg-toasts">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.toasts") %></h2></div>
  <div class="card-body">
    <button type="button" class="btn btn-outline-primary"
            data-controller="styleguide"
            data-action="click->styleguide#toast"
            data-styleguide-title-value="<%= t("styleguide.toasts.title") %>"
            data-styleguide-body-value="<%= t("styleguide.toasts.body") %>">
      <%= t("styleguide.toasts.button") %>
    </button>
  </div>
</div>

<div class="card mb-3" id="sg-notifications">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.notifications") %></h2></div>
  <div class="card-body d-flex flex-column gap-3">
    <p class="text-secondary small mb-0"><%= t("styleguide.notifications.intro") %></p>
    <div class="d-flex align-items-center gap-2">
      <span class="nav-link px-0 d-inline-flex align-items-center gap-1 text-body">
        <i class="ti ti-bell" aria-hidden="true"></i>
        <span class="badge bg-red text-white">2</span>
      </span>
      <span class="text-secondary small"><%= t("notifications.bell.label_unread", count: 2) %></span>
    </div>
    <div class="dropdown-menu dropdown-menu-card show position-static">
      <div class="card">
        <div class="card-header"><h3 class="card-title"><%= t("notifications.dropdown.title") %></h3></div>
        <div class="list-group list-group-flush list-group-hoverable">
          <a href="#" class="list-group-item list-group-item-action d-flex align-items-center gap-2">
            <span class="avatar avatar-sm" style="background-color: #1971c2; color: #fff" aria-hidden="true">DD</span>
            <span class="flex-fill">
              <span class="d-block fw-semibold"><%= t("styleguide.notifications.unread", name: "Demo") %></span>
              <span class="d-block text-secondary small"><%= t("styleguide.notifications.handle") %></span>
            </span>
            <span class="status-dot status-dot-animated bg-primary" aria-hidden="true"></span>
            <span class="visually-hidden"><%= t("notifications.unread") %></span>
          </a>
          <a href="#" class="list-group-item list-group-item-action d-flex align-items-center gap-2">
            <span class="avatar avatar-sm" style="background-color: #1971c2; color: #fff" aria-hidden="true">DD</span>
            <span class="flex-fill">
              <span class="d-block"><%= t("styleguide.notifications.read", name: "Demo") %></span>
              <span class="d-block text-secondary small"><%= t("styleguide.notifications.handle") %></span>
            </span>
          </a>
        </div>
        <div class="card-footer d-flex align-items-center gap-2">
          <span class="btn btn-sm btn-ghost-secondary"><%= t("styleguide.notifications.mark_all_read") %></span>
          <span class="btn btn-sm btn-primary ms-auto"><%= t("styleguide.notifications.view_all") %></span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card mb-3" id="sg-modal">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.modal") %></h2></div>
  <div class="card-body">
    <form action="<%= styleguide_path %>" method="get" data-confirm-title="<%= t("styleguide.modal.title") %>" data-confirm-body="<%= t("styleguide.modal.body") %>" data-confirm-verb="<%= t("styleguide.modal.verb") %>">
      <button type="submit" class="btn btn-outline-danger"><%= t("styleguide.modal.button") %></button>
    </form>
  </div>
</div>

<div class="card mb-3" id="sg-unsaved-changes">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.unsaved_changes") %></h2></div>
  <div class="card-body">
    <p class="text-secondary small"><%= t("styleguide.unsaved_changes.hint") %></p>
    <%# The dialog itself is rendered once in the application layout, as the
        release-notes one is: this opens the real component. %>
    <button type="button" class="btn btn-outline-secondary"
            data-bs-toggle="modal" data-bs-target="#unsaved-changes-modal">
      <%= t("styleguide.unsaved_changes.dialog_button") %>
    </button>
  </div>
</div>

<div class="card mb-3" id="sg-release-notes">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.release_notes") %></h2></div>
  <div class="card-body">
    <p class="text-secondary small mb-2"><%= t("styleguide.release_notes.hint") %></p>
    <%# The dialog itself is rendered once in the application layout (§10.9);
        this card only demonstrates the footer trigger. Signed out, or on a
        release with no curated notes, it degrades to the plain version. %>
    <% if signed_in? && current_release_notes.present? %>
      <button type="button" class="btn btn-link link-secondary p-0 align-baseline"
              data-bs-toggle="modal" data-bs-target="#release-notes-modal"
              aria-haspopup="dialog">
        <%= t("release_notes.footer_version", version: Allure::VERSION) %>
      </button>
    <% else %>
      <span class="text-secondary"><%= t("release_notes.footer_version", version: Allure::VERSION) %></span>
    <% end %>
  </div>
</div>

<div class="card mb-3" id="sg-admin">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.admin") %></h2></div>
  <div class="card-body">
    <p class="text-secondary small mb-2"><%= t("styleguide.admin.hint") %></p>
    <%# Static preview of the console topbar (DESIGN.md §7.6). The real chrome
        is operator-only; the guide renders the shell read-only so the icons,
        labels and exit action stay visible to every viewer in dev/test. %>
    <div class="border rounded p-2 d-flex align-items-center gap-2 flex-wrap">
      <%= render "shared/brand_mark", size: "fs-2" %>
      <span class="badge bg-primary-lt text-uppercase"><%= t("admin.console") %></span>
      <% Allure::Navigation.sections(position: :admin).flat_map(&:items).each do |item| %>
        <span class="text-secondary small">
          <i class="ti ti-<%= item.icon %> me-1" aria-hidden="true"></i><%= t("navigation.#{item.key}") %>
        </span>
      <% end %>
      <span class="ms-auto"><%= link_to t("admin.exit"), me_path, class: "btn btn-outline-secondary btn-sm" %></span>
    </div>
    <p class="text-secondary small mb-0 mt-2"><%= t("styleguide.admin.entry_hint") %></p>
  </div>
</div>

<div class="card mb-3" id="sg-states">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.states") %></h2></div>
  <div class="card-body d-flex flex-column gap-3">
    <div>
      <p class="text-secondary small" role="status"><%= t("styleguide.states.loading") %></p>
      <%# Shape-matched skeleton (DESIGN.md §11.1): header line, metric grid and
          table rows, never a generic bar or a centred spinner. %>
      <div class="card" aria-hidden="true">
        <div class="card-header placeholder-glow"><span class="placeholder col-4"></span></div>
        <div class="card-body placeholder-glow">
          <dl class="allure-secondary-metrics mb-3">
            <% 4.times do %>
              <div>
                <dt><span class="placeholder col-7"></span></dt>
                <dd><span class="placeholder col-10"></span></dd>
              </div>
            <% end %>
          </dl>
          <table class="table table-sm mb-0">
            <tbody>
              <% 3.times do %>
                <tr>
                  <td><span class="placeholder col-8"></span></td>
                  <td><span class="placeholder col-6"></span></td>
                  <td><span class="placeholder col-4"></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="empty">
      <div class="empty-icon"><i class="ti ti-chart-bar fs-1 text-primary"></i></div>
      <p class="empty-title"><%= t("styleguide.states.error_title") %></p>
      <p class="empty-subtitle text-secondary"><%= t("styleguide.states.error_body") %></p>
      <div class="empty-action"><span class="btn btn-outline-primary"><%= t("styleguide.states.retry") %></span></div>
    </div>
    <div class="alert alert-warning mb-0" role="alert"><%= t("styleguide.states.partial") %></div>
    <div class="empty">
      <div class="empty-icon"><i class="ti ti-mountain fs-1 text-primary"></i></div>
      <p class="empty-title"><%= t("styleguide.states.empty_filtered") %></p>
      <div class="empty-action"><span class="btn btn-outline-primary"><%= t("styleguide.states.empty_filtered_action") %></span></div>
    </div>
  </div>
</div>

<div class="card mb-3" id="sg-remote">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.remote") %></h2></div>
  <div class="card-body d-flex flex-column gap-3">
    <article class="card">
      <div class="card-body">
        <div class="d-flex align-items-start mb-3">
          <span class="avatar avatar-md me-2 flex-shrink-0" style="background-color: #1971c2; color: #fff" aria-hidden="true">DD</span>
          <div class="flex-fill">
            <div class="d-flex flex-wrap align-items-baseline gap-2">
              <span class="fw-bold"><%= t("styleguide.remote.author") %></span>
              <span class="text-secondary small">@demo@exemple.test</span>
            </div>
            <div class="text-secondary small"><%= t("styleguide.remote.date") %> · 26,6 km · 2:04:15</div>
          </div>
          <span class="text-secondary small"><i class="ti ti-route" aria-hidden="true"></i></span>
        </div>
        <h3 class="h4 mb-2"><%= t("styleguide.remote.title") %></h3>
        <div class="d-flex flex-wrap align-items-center gap-2">
          <div class="text-secondary small"><%= t("workouts.show.metrics.moving_time") %>: 1:42:48 · <%= t("workouts.show.metrics.ascent") %>: 114 m</div>
          <div class="ms-auto"><span class="btn btn-sm btn-outline-primary"><%= t("remote_notes.open") %></span></div>
        </div>
      </div>
    </article>
    <div class="card">
      <div class="card-body d-flex align-items-center gap-3" role="status" aria-live="polite">
        <span class="spinner-border spinner-border-sm text-secondary" aria-hidden="true"></span>
        <p class="text-secondary mb-0"><%= t("remote_notes.media.pending") %></p>
      </div>
    </div>
    <div class="alert alert-warning mb-0" role="alert"><%= t("remote_notes.media.unavailable") %></div>
    <div class="empty">
      <div class="empty-icon"><i class="ti ti-world-off fs-1 text-secondary" aria-hidden="true"></i></div>
      <p class="empty-title"><%= t("remote_notes.deleted.title") %></p>
      <p class="empty-subtitle text-secondary"><%= t("remote_notes.deleted.body") %></p>
    </div>
  </div>
</div>

<% if @sports.any? %>
  <div class="card mb-3" id="sg-sports">
    <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.sports") %></h2></div>
    <div class="card-body">
      <p class="text-secondary small"><%= t("styleguide.sports_intro") %></p>
      <div class="btn-list">
        <% @sports.each do |sport| %>
          <span class="d-inline-flex align-items-center gap-2"><%= sport_tile_tag(sport, size: :sm) %><%= sport_display_name(sport) %></span>
        <% end %>
      </div>
    </div>
  </div>

  <% icon_sizes = %w[xs sm md lg] %>
  <div class="card mb-3" id="sg-icons">
    <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.icons") %></h2></div>
    <div class="card-body">
      <p class="text-secondary small"><%= t("styleguide.icons_intro") %></p>
      <div class="row row-cards mb-3">
        <% @sports.each do |sport| %>
          <div class="col-6 col-sm-4 col-lg-3 col-xl-2">
            <div class="d-flex align-items-center gap-3">
              <%= sport_tile_tag(sport, size: :lg) %>
              <div>
                <div class="fw-bold"><%= sport_display_name(sport) %></div>
                <code class="text-secondary small"><%= sport.slug %></code>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      <div class="table-responsive">
        <table class="table table-sm table-vcenter">
          <caption class="visually-hidden"><%= t("styleguide.icons.table_caption") %></caption>
          <thead>
            <tr>
              <th scope="col"><%= t("styleguide.icons.sport") %></th>
              <th scope="col"><%= t("styleguide.icons.slug") %></th>
              <% icon_sizes.each do |size| %>
                <th scope="col"><%= t("styleguide.icons.sizes.#{size}") %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @sports.each do |sport| %>
              <tr>
                <th scope="row" class="fw-normal"><%= sport_display_name(sport) %></th>
                <td><code class="text-secondary small"><%= sport.slug %></code></td>
                <% icon_sizes.each do |size| %>
                  <td><%= sport_tile_tag(sport, size: size) %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>

<div class="card mb-3" id="sg-contrast" data-controller="contrast">
  <div class="card-header"><h2 class="card-title h3"><%= t("styleguide.sections.contrast") %></h2></div>
  <div class="card-body">
    <p class="text-secondary small"><%= t("styleguide.contrast.avatars_intro") %></p>
    <div class="d-flex flex-wrap gap-2">
      <% @avatar_contrasts.each do |hex, white_ratio| %>
        <div class="text-center">
          <span class="avatar avatar-md" data-contrast-target="swatch" data-contrast-color="<%= hex %>"
                style="background-color: <%= hex %>; color: #fff" aria-hidden="true">AA</span>
          <div class="small mt-1"><code><%= hex %></code></div>
          <div class="small text-secondary"><%= t("styleguide.contrast.on_white", ratio: white_ratio) %></div>
          <div class="small text-secondary"><%= t("styleguide.contrast.on_surface") %> <span data-contrast-target="ratio">…</span></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
