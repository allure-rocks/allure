<%# The demo credentials block (PLAN_DEMO.md §6): the instance's whole point is
    that a visitor may walk in, so the sign-in page names the shared accounts,
    the shared password, and the privacy sentence that keeps personal data
    out. Rendered only in demo mode; registration is closed either way. %>
<% if Allure::Demo.enabled? && demo_accounts.any? %>
  <div class="card card-sm mt-3 demo-credentials">
    <div class="card-body">
      <h2 class="card-title"><%= t("demo.credentials.title") %></h2>
      <p class="text-secondary"><%= t("demo.credentials.sentence") %></p>
      <ul class="list-unstyled mb-2">
        <% demo_accounts.each do |account| %>
          <li>
            <code><%= account.email_address %></code>
            <%= t(account.instance_operator? ? "demo.credentials.admin" : "demo.credentials.member") %>
          </li>
        <% end %>
      </ul>
      <% if demo_password %>
        <p class="mb-0"><%= t("demo.credentials.password") %> <code><%= demo_password %></code></p>
      <% end %>
    </div>
  </div>
<% end %>
