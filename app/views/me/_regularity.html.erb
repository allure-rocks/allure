<% average = @week[:average][:distance].to_f %>
<% percent = average.positive? ? (@week[:current][:distance].to_f / average * 100) : 0 %>
<% progress = [ percent.round, 100 ].min %>

<div class="card h-100">
  <div class="card-header">
    <h3 class="card-title"><%= t("me.regularity.title") %></h3>
    <div class="card-actions">
      <%= link_to stats_path, class: "btn btn-sm btn-ghost-primary" do %><%= t("me.stats.action") %><i class="ti ti-chevron-right ms-1" aria-hidden="true"></i><% end %>
    </div>
  </div>
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-baseline">
      <div class="text-secondary small text-uppercase"><%= t("me.week.title") %></div>
      <div class="h2 mb-0"><%= format_distance(@week[:current][:distance]) %></div>
    </div>
    <% if average.positive? %>
      <div class="progress progress-sm mt-2" role="progressbar"
           aria-label="<%= t("me.week.progress", percent: percent.round) %>"
           aria-valuenow="<%= progress %>" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar" style="width: <%= progress %>%"></div>
      </div>
    <% end %>
    <div class="text-secondary small mt-2">
      <%= t("me.week.average", value: format_distance(@week[:average][:distance])) %>
      · <%= t("me.week.activities", count: @week[:current][:workouts]) %>
    </div>

    <hr>

    <div class="row g-3 text-center">
      <div class="col-6">
        <div class="h3 mb-0"><%= @regularity[:current] %></div>
        <div class="text-secondary small">
          <i class="ti ti-flame me-1" aria-hidden="true"></i><%= t("me.regularity.current_streak") %>
        </div>
      </div>
      <div class="col-6">
        <div class="h3 mb-0"><%= @regularity[:longest] %></div>
        <div class="text-secondary small">
          <i class="ti ti-flame me-1" aria-hidden="true"></i><%= t("me.regularity.longest_streak") %>
        </div>
      </div>
      <div class="col-6">
        <div class="h3 mb-0"><%= t("me.regularity.active_days_value", count: @regularity[:active_days], total: @regularity[:active_window]) %></div>
        <div class="text-secondary small">
          <i class="ti ti-calendar-check me-1" aria-hidden="true"></i><%= t("me.regularity.active_days") %>
        </div>
      </div>
      <div class="col-6">
        <div class="h3 mb-0"><%= format_distance(@regularity[:best_week][:distance]) %></div>
        <div class="text-secondary small">
          <i class="ti ti-calendar-star me-1" aria-hidden="true"></i><%= t("me.regularity.best_week") %>
        </div>
      </div>
    </div>
  </div>
</div>
