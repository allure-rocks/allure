<%= t("security_mailer.notice.greeting", name: @user.display_name) %>

<%= t("security_mailer.notice.bodies.#{@event}", provider: @provider, token: @token_name) %>
<% if @mcp_geometry %>

<%= t("security_mailer.notice.mcp_geometry.#{@mcp_geometry}") %>
<% end %>
<% unless @remaining.nil? %>

<%= t("security_mailer.notice.remaining", count: @remaining) %>
<% end %>

<%= t("security_mailer.notice.not_you") %>

<%= settings_security_url %>
