<% device_messages = t("workouts.batch_import.sources.igpsport_device.messages").merge(
  select_all: t("workouts.batch_import.sources.igpsport_device.select_all"),
  clear_all: t("workouts.batch_import.sources.igpsport_device.clear_all")
) %>

<%# The iOS companion has no Web Bluetooth; when it registers the `igpsport`
    bridge component the panel borrows the phone's radio instead
    (docs/dev/IMPORT-SOURCES.md). An older app is asked to update. %>
<% native = hotwire_native_bridge?(:igpsport) %>
<div class="card mb-3">
  <%= tag.div class: "card-body",
              data: { controller: class_names("igpsport-device", "bridge--igpsport": native),
                      igpsport_device_messages_value: device_messages.to_json,
                      igpsport_device_native_value: native } do %>
    <div class="alert alert-warning mb-0" data-igpsport-device-target="unsupported" hidden>
      <i class="ti ti-bluetooth-off me-1"></i><%= t("workouts.batch_import.sources.igpsport_device.#{hotwire_native_app? ? 'requirements_native' : 'requirements'}") %>
    </div>

    <div data-igpsport-device-target="supported" hidden>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <button type="button" class="btn btn-primary" data-igpsport-device-target="connect"
                data-action="igpsport-device#connectDevice">
          <i class="ti ti-bluetooth me-1"></i><%= t("workouts.batch_import.sources.igpsport_device.connect") %>
        </button>
        <button type="button" class="btn btn-outline-secondary" data-igpsport-device-target="disconnect"
                data-action="igpsport-device#disconnectDevice" hidden>
          <%= t("workouts.batch_import.sources.igpsport_device.disconnect") %>
        </button>
        <button type="button" class="btn btn-outline-primary" data-igpsport-device-target="refresh"
                data-action="igpsport-device#refresh" hidden>
          <i class="ti ti-refresh me-1"></i><%= t("workouts.batch_import.sources.igpsport_device.list") %>
        </button>
        <span class="text-secondary small" role="status" data-igpsport-device-target="status"></span>
      </div>

      <div class="mt-3" data-igpsport-device-target="deviceInfo" hidden>
        <dl class="row mb-0">
          <dt class="col-auto"><%= t("workouts.batch_import.sources.igpsport_device.model") %></dt>
          <dd class="col-auto">
            <span data-igpsport-device-target="model"></span>
            <span class="badge bg-secondary-lt ms-1" data-igpsport-device-target="untested" hidden>
              <%= t("workouts.batch_import.sources.igpsport_device.untested") %>
            </span>
          </dd>
          <dt class="col-auto"><%= t("workouts.batch_import.sources.igpsport_device.serial") %></dt>
          <dd class="col-auto" data-igpsport-device-target="serial"></dd>
          <dt class="col-auto"><%= t("workouts.batch_import.sources.igpsport_device.battery") %></dt>
          <dd class="col-auto mb-0" data-igpsport-device-target="battery"></dd>
        </dl>
        <p class="text-secondary small mt-2 mb-0" data-igpsport-device-target="untestedHint" hidden>
          <%= t("workouts.batch_import.sources.igpsport_device.untested_hint") %>
        </p>
      </div>

      <div class="mt-3" data-igpsport-device-target="activities" hidden>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
          <span class="text-secondary small" data-igpsport-device-target="summary"></span>
          <button type="button" class="btn btn-sm btn-ghost-secondary" data-igpsport-device-target="toggleAll"
                  data-action="igpsport-device#toggleAll">
            <%= t("workouts.batch_import.sources.igpsport_device.select_all") %>
          </button>
        </div>
        <ul class="list-group list-group-flush" data-igpsport-device-target="list"></ul>
      </div>

      <div class="mt-3" data-igpsport-device-target="progressPanel" hidden>
        <div class="progress mb-2" role="progressbar" aria-valuemin="0" aria-valuemax="100"
             data-igpsport-device-target="progressbar">
          <div class="progress-bar" style="width: 0%" data-igpsport-device-target="progressBar"></div>
        </div>
        <p class="text-secondary small mb-0" data-igpsport-device-target="progressText"></p>
      </div>

      <div class="mt-3 d-flex flex-wrap align-items-center gap-2">
        <button type="button" class="btn btn-primary" data-igpsport-device-target="import"
                data-action="igpsport-device#importSelected" disabled>
          <i class="ti ti-download me-1"></i><%= t("workouts.batch_import.sources.igpsport_device.import") %>
        </button>
        <span class="text-secondary small"><%= t("workouts.batch_import.sources.igpsport_device.import_hint") %></span>
      </div>

      <details class="mt-3">
        <summary class="text-secondary small"><%= t("workouts.batch_import.sources.igpsport_device.log") %></summary>
        <pre class="small text-secondary mt-2 mb-0" data-igpsport-device-target="log"></pre>
      </details>
    </div>
  <% end %>
</div>
