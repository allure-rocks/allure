<%# Commute marker (DESIGN.md §10.4): one badge kind, icon plus text. Shown
    wherever the workout is presented to someone allowed to see the flag.
    `compact` keeps the icon alone, named by its tooltip (workout cards). %>
<% if local_assigns.fetch(:compact, false) %>
  <span class="badge bg-secondary-lt allure-badge-icon" role="img" tabindex="0"
        aria-label="<%= t("workouts.commute.badge") %>" <%= tag.attributes(data: tooltip_data(t("workouts.commute.badge"))) %>>
    <i class="ti ti-briefcase" aria-hidden="true"></i>
  </span>
<% else %>
  <span class="badge bg-secondary-lt">
    <i class="ti ti-briefcase me-1" aria-hidden="true"></i><%= t("workouts.commute.badge") %>
  </span>
<% end %>
