<%# One active publication in the sharing list (DESIGN.md §20.3), one per
    audience (docs/dev/PUBLISHING.md): its
    audience, profile and date, the reader's view and the shared media, the
    replace and withdraw actions, and a distribution alert when sending has a
    problem. Locals: `workout`, `publication`, `delivery_summary`, `form_id`
    (the replace form to unfold, or nil), `automatic` (an automatic profile
    made it, docs/dev/AUTO-PUBLISHING.md). %>
<% profile_name = publication.profile_snapshot["name"].presence || publication.publishing_profile&.name %>
<li class="list-group-item allure-publication-row">
  <div class="d-flex flex-wrap align-items-center gap-2">
    <%= publication_badge(publication.audience) %>
    <div class="me-auto">
      <div class="fw-semibold"><%= profile_name.present? ? t("workouts.snapshot.profile", name: profile_name) : t("workouts.snapshot.profile_removed") %></div>
      <div class="text-secondary small">
        <%= t("workouts.snapshot.published_on", date: format_started_at(publication.published_at)) %>
        <% if local_assigns[:automatic] %>
          · <i class="ti ti-bolt" aria-hidden="true"></i> <%= t("auto_publications.badge") %>
        <% end %>
      </div>
    </div>
    <div class="btn-list flex-nowrap">
      <% if form_id %>
        <button type="button" class="btn btn-sm btn-outline-secondary collapsed" data-bs-toggle="collapse"
                data-bs-target="#<%= form_id %>" aria-expanded="false" aria-controls="<%= form_id %>">
          <i class="ti ti-refresh me-1" aria-hidden="true"></i><%= t("workouts.publication.replace_short") %>
        </button>
      <% end %>
      <%= button_to publication_workout_path(workout), method: :delete, params: { publication_id: publication.to_param },
                    form: { data: { confirm_title: t("workouts.publication.confirm.title"), confirm_body: t("workouts.publication.confirm.body"), confirm_verb: t("workouts.publication.confirm.verb") } },
                    class: "btn btn-sm btn-ghost-danger" do %>
        <%= t("workouts.publication.withdraw") %>
      <% end %>
    </div>
  </div>
  <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
    <%= link_to workout_path(workout, as: :publication, audience: publication.audience), class: "btn btn-sm btn-ghost-primary" do %>
      <i class="ti ti-eye me-1" aria-hidden="true"></i><%= t("workouts.publication.view_as_reader") %>
    <% end %>
    <% if publication.sanitized_attachment(:gpx) %>
      <%= link_to publication_gpx_path(publication), class: "btn btn-sm btn-ghost-secondary",
                  data: { controller: "bridge--download", bridge__download_url_value: publication_gpx_path(publication) } do %>
        <i class="ti ti-file-download me-1" aria-hidden="true"></i><%= t("workouts.snapshot.media_gpx") %>
      <% end %>
    <% end %>
    <% if publication.sanitized_attachment(:route_image) %>
      <%= link_to publication_route_image_path(publication), class: "btn btn-sm btn-ghost-secondary" do %>
        <i class="ti ti-photo me-1" aria-hidden="true"></i><%= t("workouts.snapshot.media_route_image") %>
      <% end %>
    <% end %>
  </div>
  <%= render "delivery_summary", workout:, publication:, summary: delivery_summary if delivery_summary %>
</li>
