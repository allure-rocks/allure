<%# The metrics-only participant presentation (PLAN_TOGETHER.md §4.1): the
    credited metric set of an unpublished source workout, and nothing else. No
    geometry, no description, no notes, no device, no physiological channel. %>
<% metrics = participant_metric_items(workout) %>
<% primary_metrics, secondary_metrics = metrics.partition { |metric| metric[:primary] } %>
<% primary_metrics.sort_by! { |metric| metric[:priority] } %>
<div class="card mb-3 allure-workout-summary">
  <div class="card-header">
    <h2 class="card-title"><%= t("workouts.show.sections.summary") %></h2>
  </div>
  <div class="card-body">
    <% if primary_metrics.any? %>
      <dl class="allure-primary-metrics mb-0">
        <% primary_metrics.each do |metric| %>
          <%= render "workouts/metric_tile", metric:, trophy_label: nil %>
        <% end %>
      </dl>
    <% end %>

    <% if secondary_metrics.any? %>
      <dl class="allure-secondary-metrics mb-0<%= " mt-4 pt-4 border-top" if primary_metrics.any? %>">
        <% secondary_metrics.each do |metric| %>
          <div>
            <dt><%= metric[:label] %></dt>
            <dd><%= workout_metric_value(metric) %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <p class="text-secondary small mt-4 mb-0">
      <i class="ti ti-info-circle me-1" aria-hidden="true"></i><%= local_assigns.fetch(:hint) { t("workouts.participations.metrics_hint") } %>
    </p>
  </div>
</div>
