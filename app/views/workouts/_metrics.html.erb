<% metrics = workout_metric_items(workout) %>
<% record_labels = local_assigns.fetch(:record_labels, {}) %>
<%# Owner-only: a figure an anomaly makes wrong carries its plausible value
    (DESIGN.md §15.5). %>
<% anomaly_notes = local_assigns.fetch(:anomaly_notes, {}) %>
<% primary_metrics, secondary_metrics = metrics.partition { |metric| metric[:primary] } %>
<%# Secondary metrics the file did not record are not listed as dashes: they
    are named once, under the grid (DESIGN.md §20.3). %>
<% missing_labels = workout_missing_metric_labels(secondary_metrics) %>
<% secondary_metrics = secondary_metrics.select { |metric| workout_metric_recorded?(metric) } %>
<% primary_metrics.sort_by! { |metric| metric[:priority] } %>
<div class="card mb-3 allure-workout-summary">
  <div class="card-header">
    <h2 class="card-title"><%= t("workouts.show.sections.summary") %></h2>
  </div>
  <div class="card-body">
    <% if primary_metrics.any? %>
      <dl class="allure-primary-metrics mb-0">
        <% primary_metrics.each do |metric| %>
          <% record_label = record_labels[metric[:key]] %>
          <%= render "workouts/metric_tile", metric:,
                     trophy_label: (record_label && t("medals.record", record: record_label)),
                     anomaly_note: anomaly_notes[metric[:key]] %>
        <% end %>
      </dl>
    <% end %>

    <%# The text block under the primary tiles (DESIGN.md §20.3): prepared by
        the page, so this partial owns only its place and its separators. %>
    <% lead = local_assigns[:lead] %>
    <% if lead.present? %>
      <div class="<%= "mt-4 pt-4 border-top" if primary_metrics.any? %>"><%= lead %></div>
    <% end %>

    <% if secondary_metrics.any? %>
      <%# On phones the secondary metrics fold behind one toggle when the
          primary tiles already lead the card (DESIGN.md §20.3). The toggle
          sits above them, so it stays in place whether they are shown. %>
      <% collapsible = local_assigns.fetch(:collapsible, false) && primary_metrics.any? %>
      <% secondary_id = "workout-secondary-metrics" %>
      <div class="<%= class_names("allure-secondary-metrics-wrap", "mt-4 pt-4 border-top" => primary_metrics.any? || lead.present?) %>"
           <% if collapsible %>data-controller="disclosure"
           data-disclosure-collapsed-label-value="<%= t("workouts.show.metrics.more", count: secondary_metrics.size) %>"
           data-disclosure-expanded-label-value="<%= t("workouts.show.metrics.less") %>"<% end %>>
        <% if collapsible %>
          <button type="button" class="btn btn-sm btn-ghost-secondary w-100 allure-disclosure-toggle"
                  aria-controls="<%= secondary_id %>" aria-expanded="false"
                  data-disclosure-target="button" data-action="disclosure#toggle">
            <span data-disclosure-target="label"><%= t("workouts.show.metrics.more", count: secondary_metrics.size) %></span>
            <i class="ti ti-chevron-down ms-1 allure-disclosure-chevron" aria-hidden="true"></i>
          </button>
        <% end %>
        <dl id="<%= secondary_id %>" class="<%= class_names("allure-secondary-metrics mb-0", "allure-collapsible-sm" => collapsible) %>"
            <% if collapsible %>data-disclosure-target="content"<% end %>>
          <% secondary_metrics.each do |metric| %>
            <div>
              <dt>
                <%= metric[:label] %>
                <%= render "workouts/record_trophy", label: record_labels[metric[:key]] if record_labels[metric[:key]] %>
                <%= render "workouts/anomaly_note", note: anomaly_notes[metric[:key]] if anomaly_notes[metric[:key]] %>
              </dt>
              <dd><%= workout_metric_value(metric) %></dd>
            </div>
          <% end %>
        </dl>
        <%# Named with the extra metrics, so it folds with them on phones. %>
        <% if missing_labels.any? %>
          <%= render "workouts/metrics_missing", labels: missing_labels,
                     class_name: class_names("mt-3", "allure-collapsible-sm" => collapsible),
                     disclosure: collapsible %>
        <% end %>
      </div>
    <% end %>

    <% if missing_labels.any? && secondary_metrics.none? %>
      <%= render "workouts/metrics_missing", labels: missing_labels, class_name: ("mt-3" if metrics.any?) %>
    <% end %>

    <% if local_assigns[:elevation_notice].present? %>
      <div class="<%= "mt-4 pt-4 border-top" if metrics.any? %>">
        <%= render "workouts/elevation_notice", workout:, notice: local_assigns[:elevation_notice] %>
      </div>
    <% end %>

    <% if local_assigns[:notes].present? %>
      <aside class="alert alert-secondary mt-4 mb-0" aria-labelledby="private-notes-title">
        <h3 class="h4 alert-title" id="private-notes-title">
          <i class="ti ti-lock me-1" aria-hidden="true"></i><%= t("workouts.show.private_notes") %>
        </h3>
        <%= simple_format(h(local_assigns[:notes]), class: "mb-0") %>
      </aside>
    <% end %>
  </div>
</div>
