<%# Sharing (DESIGN.md §19, §20.3): one card listing the workout's
    publications — one per audience at most (docs/dev/PUBLISHING.md), the
    scheduled ones inside their safety delay, then the active ones, narrowest
    first — each with its own actions. Publish, add and replace actions go
    to the dedicated form. The header withdraws every active publication.
    Automatic publications (docs/dev/AUTO-PUBLISHING.md) lead the
    card while they wait, with « Ne pas publier »; a publication they made is
    marked, and one they did not make says why. Locals: `workout`,
    `active_publications`, `scheduled_publications`, `can_add_publication`,
    `delivery_summaries`, `auto_publications`. %>
<%# A positionless recording has no route to share, so the card states why
    instead of offering the form (docs/dev/NO-GPS.md). %>
<% positionless = workout.recording? && !workout.positioned? %>
<% listed = active_publications.any? || scheduled_publications.any? %>
<% auto_publications = local_assigns.fetch(:auto_publications, []) %>
<% automatic_ids = auto_publications.select(&:published?).filter_map(&:workout_publication_id) %>
<% live_audiences = (active_publications + scheduled_publications).map(&:audience) %>
<% auto_waiting = auto_publications.select(&:waiting?) %>
<% auto_unpublished = auto_publications.select do |row|
     (row.skipped? || row.failed?) && !row.reason.in?(%w[cancelled_by_owner already_published]) && !live_audiences.include?(row.audience)
   end %>
<div class="card mb-3 allure-sharing-card">
  <div class="card-header">
    <div>
      <h2 class="card-title"><%= t("workouts.publication.list_title") %></h2>
      <% if !listed %>
        <div class="text-secondary small mt-1"><%= t("workouts.publication.not_published") %></div>
      <% elsif !can_add_publication %>
        <div class="text-secondary small mt-1"><%= t("workouts.publication.add_unavailable") %></div>
      <% end %>
    </div>
    <div class="card-actions d-flex flex-wrap align-items-center gap-2">
      <% if can_add_publication %>
        <%= link_to new_publication_workout_path(workout), class: "btn btn-sm btn-primary" do %>
          <i class="ti ti-plus me-1" aria-hidden="true"></i><%= t(listed ? "workouts.publication.add" : "workouts.publication.publish") %>
        <% end %>
      <% end %>
      <% if active_publications.any? %>
        <%# A row's own `⋯` carries Retirer below lg (DESIGN.md §20.3). %>
        <%= button_to publication_workout_path(workout), method: :delete,
                      form: { class: "d-none d-lg-block", data: { confirm_title: t("workouts.publication.confirm_all.title"), confirm_body: t("workouts.publication.confirm_all.body"), confirm_verb: t("workouts.publication.confirm_all.verb") } },
                      class: "btn btn-sm btn-ghost-danger" do %>
          <i class="ti ti-trash me-1" aria-hidden="true"></i><%= t("workouts.publication.delete_all") %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if auto_waiting.any? || auto_unpublished.any? %>
    <ul class="list-group list-group-flush allure-auto-publication-list">
      <% auto_waiting.each do |row| %>
        <li class="list-group-item allure-auto-publication">
          <div class="d-flex flex-wrap align-items-center gap-2">
            <i class="ti ti-hourglass text-secondary" aria-hidden="true"></i>
            <div class="me-auto">
              <div class="fw-semibold"><%= auto_publication_text(row) %></div>
              <div class="text-secondary small"><%= t("auto_publications.waiting_hint") %></div>
            </div>
            <%= button_to t("auto_publications.cancel.button"), auto_publication_workout_path(workout), method: :delete,
                          params: { audience: row.audience },
                          form: { data: { confirm_title: t("auto_publications.cancel.confirm.title"), confirm_body: t("auto_publications.cancel.confirm.body"), confirm_verb: t("auto_publications.cancel.confirm.verb") } },
                          class: "btn btn-sm btn-outline-secondary" %>
          </div>
        </li>
      <% end %>
      <% auto_unpublished.each do |row| %>
        <li class="list-group-item allure-auto-publication">
          <div class="d-flex align-items-start gap-2 small <%= row.failed? ? "text-warning" : "text-secondary" %>">
            <i class="ti ti-<%= auto_publication_icon(row) %> mt-1" aria-hidden="true"></i>
            <span><%= auto_publication_text(row) %><% if row.failed? && row.detail.present? %> — <%= row.detail %><% end %></span>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if positionless %>
    <div class="card-body text-secondary">
      <i class="ti ti-map-off me-1" aria-hidden="true"></i><%= t("workouts.publication.no_position") %>
    </div>
  <% else %>
    <% if listed %>
      <ul class="list-group list-group-flush allure-publication-list">
        <% scheduled_publications.each do |publication| %>
          <%= render "scheduled", workout:, publication:, automatic: automatic_ids.include?(publication.id) %>
        <% end %>
        <% active_publications.each do |publication| %>
          <%= render "publication_row", workout:, publication:,
                                        delivery_summary: delivery_summaries[publication.id],
                                        automatic: automatic_ids.include?(publication.id) %>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
